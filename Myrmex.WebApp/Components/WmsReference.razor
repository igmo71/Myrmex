<MudTooltip Text="@Tooltip">
    <MudText Typo="Typo.body2" Class="wms-reference" title="@Tooltip">
        <span class="wms-reference__name">@DisplayName</span>
    </MudText>
</MudTooltip>

@code {
    [Parameter, EditorRequired] public string? Name { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public string? Fallback { get; set; }
    private bool HasName => !string.IsNullOrWhiteSpace(Name);
    private string ShortCode => Code?.Length > 12 ? Code[..12] : Code ?? string.Empty;
    private string DisplayName => HasName ? Name! : !string.IsNullOrWhiteSpace(Code) ? ShortCode : Fallback ?? string.Empty;
    private string Tooltip => HasName || string.IsNullOrWhiteSpace(Code) ? DisplayName : Code;
}
