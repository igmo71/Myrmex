@page "/integrations/1c"
@rendermode InteractiveServer
@using Myrmex.Shared.Integrations.OneC
@using Myrmex.WebApp.Integrations.OneC
@inject OneCIntegrationApiClient ApiClient
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["OneC.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h4" GutterBottom="true">@Localizer["OneC.Heading"]</MudText>
    <MudText Class="mb-4">
        @Localizer["OneC.Connection.Description"]
    </MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@_isChecking"
                   OnClick="TestConnectionAsync">
            @(Localizer[_isChecking ? "OneC.Connection.Checking" : "OneC.Connection.Check"])
        </MudButton>
        @if (_response is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4">
                @Localizer["OneC.Connection.Ready", _response.CheckedAtUtc.ToLocalTime().ToString("g")]
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </MudStack>
    <MudDivider Class="my-6" />
    <MudText Typo="Typo.h5" GutterBottom="true">@Localizer["OneC.Import.Title"]</MudText>
    <MudStack Row="true" Spacing="2">
        <MudStack Row="false" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Disabled="@IsWarehouseImporting"
                       OnClick="ImportWarehousesAsync"
                       Class="mt-3">
                @(Localizer[IsWarehouseImporting ? "OneC.Import.Warehouses.InProgress" : "OneC.Import.Warehouses.Action"])
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Disabled="@IsUomImporting"
                       OnClick="ImportUnitsOfMeasureAsync">
                @(Localizer[IsUomImporting ? "OneC.Import.UnitsOfMeasure.InProgress" : "OneC.Import.UnitsOfMeasure.Action"])
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Disabled="@IsSkuImporting"
                       OnClick="ImportStockKeepingUnitsAsync">
                @(Localizer[IsSkuImporting ? "OneC.Import.Skus.InProgress" : "OneC.Import.Skus.Action"])
                @if (IsSkuImporting)
                {
                    <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" Class="ml-3" />
                }
            </MudButton>
        </MudStack>
        <MudStack Row="false" Spacing="2">
            @if (!string.IsNullOrWhiteSpace(_importErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_importErrorMessage</MudAlert>
            }
            @if (_importResponse is not null)
            {
                <MudAlert Severity="@(_importResponse.IsComplete ? Severity.Success : Severity.Warning)" Class="mt-3">
                    @(Localizer[_importResponse.IsComplete ? "OneC.Import.Complete" : "OneC.Import.Incomplete"])
                </MudAlert>
                <MudPaper Class="pa-2 mt-2" Elevation="1">
                    <MudText><b>@Localizer["OneC.Import.ReferenceType"]:</b> @ReferenceTypeLabel(_importResponse.ReferenceType)</MudText>
                    <MudText>
                        @Localizer["Common.Processed"]: @_importResponse.Processed;
                        @Localizer["Common.Created"]: @_importResponse.Created;
                        @Localizer["Common.Updated"]: @_importResponse.Updated;
                        @Localizer["Common.Skipped"]: @_importResponse.Skipped;
                        @Localizer["Common.Failed"]: @_importResponse.Failed.
                    </MudText>
                    @if (_importResponse.OperationError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                            @_importResponse.OperationError.Message (@_importResponse.OperationError.Reason)
                        </MudAlert>
                    }
                    @if (_importResponse.Errors.Count > 0)
                    {
                        <MudText Typo="Typo.h6" Class="mt-4">@Localizer["OneC.Import.RecordErrors.Title"]</MudText>
                        <table class="mud-table-root mt-2">
                            <thead>
                                <tr>
                                    <th>@Localizer["Common.Code"]</th>
                                    <th>@Localizer["Common.Reason"]</th>
                                    <th>@Localizer["Common.Message"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (OneCImportRecordError error in _importResponse.Errors)
                                {
                                    <tr>
                                        <td>@(error.Code ?? "—")</td>
                                        <td>@error.Reason</td>
                                        <td>@error.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </MudPaper>
            }
        </MudStack>
    </MudStack>
</MudContainer>

@code {
    private bool _isChecking;
    private OneCConnectionTestResponse? _response;
    private string? _errorMessage;
    private bool _isWarehouseImporting;
    private bool _isUomImporting;
    private bool _isSkuImporting;
    private OneCImportResponse? _importResponse;
    private string? _importErrorMessage;
    private bool IsWarehouseImporting => _isWarehouseImporting;
    private bool IsUomImporting => _isUomImporting;
    private bool IsSkuImporting => _isSkuImporting;

    private async Task TestConnectionAsync()
    {
        _isChecking = true;
        _response = null;
        _errorMessage = null;

        try
        {
            ApiResult<OneCConnectionTestResponse> result = await ApiClient.TestConnectionAsync();
            if (result.IsSuccess)
            {
                _response = result.Value;
            }
            else
            {
                _errorMessage = result.Error?.Message ?? Localizer["OneC.Connection.Error"];
            }
        }
        catch (Exception)
        {
            _errorMessage = Localizer["OneC.Connection.ApiUnavailable"];
        }
        finally
        {
            _isChecking = false;
        }
    }

    private async Task ImportWarehousesAsync()
    {
        if (_isWarehouseImporting)
        {
            return;
        }

        _isWarehouseImporting = true;
        try
        {
            await ImportAsync(ApiClient.ImportWarehousesAsync);
        }
        finally
        {
            _isWarehouseImporting = false;
        }
    }

    private async Task ImportUnitsOfMeasureAsync()
    {
        if (_isUomImporting)
        {
            return;
        }

        _isUomImporting = true;
        try
        {
            await ImportAsync(ApiClient.ImportUnitsOfMeasureAsync);
        }
        finally
        {
            _isUomImporting = false;
        }
    }

    private async Task ImportStockKeepingUnitsAsync()
    {
        if (_isSkuImporting)
        {
            return;
        }

        _isSkuImporting = true;
        try
        {
            await ImportAsync(ApiClient.ImportStockKeepingUnitsAsync);
        }
        finally
        {
            _isSkuImporting = false;
        }
    }

    private async Task ImportAsync(
        Func<CancellationToken, Task<ApiResult<OneCImportResponse>>> import)
    {
        _importErrorMessage = null;

        try
        {
            ApiResult<OneCImportResponse> result = await import(CancellationToken.None);
            if (result.IsSuccess)
            {
                _importResponse = result.Value;
            }
            else
            {
                _importErrorMessage = IsAlreadyInProgress(result.Error)
                    ? Localizer["OneC.Import.AlreadyInProgress"]
                    : result.Error?.Message ?? Localizer["OneC.Import.Error"];
            }
        }
        catch (Exception)
        {
            _importErrorMessage = Localizer["OneC.Import.ApiUnavailable"];
        }
    }

    private static bool IsAlreadyInProgress(ApiError? error) =>
        error?.Status == 409 &&
        error.Extensions.TryGetValue("code", out string? code) &&
        string.Equals(code, "OneCImport.AlreadyInProgress", StringComparison.Ordinal);

    private string ReferenceTypeLabel(string referenceType) => referenceType switch
    {
        "warehouses" => Localizer["ReferenceType.Warehouses"],
        "uoms" => Localizer["ReferenceType.UnitsOfMeasure"],
        "skus" => Localizer["ReferenceType.Skus"],
        _ => referenceType
    };
}
