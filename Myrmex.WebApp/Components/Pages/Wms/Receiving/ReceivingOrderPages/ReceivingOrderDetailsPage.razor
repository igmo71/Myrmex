@page "/wms/receiving-orders/{ReceivingOrderId:guid}"
@using Myrmex.WebApp.Components.Pages.Wms.Inventory.InventoryLedgerPages
@inject WmsReceivingApiClient ReceivingApiClient
@inject WmsInventoryApiClient InventoryApiClient
@inject IDialogService DialogService

<PageTitle>@Localizer["Receiving.DetailsTitle"]</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (_order is not null)
    {
        <MudStack Spacing="3">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div><MudText Typo="Typo.h5">@_order.Number</MudText><MudText>@FormatStatus(_order.Status)</MudText></div>
                <MudStack Row="true">
                    @if (_order.Status == ReceivingOrderStatusDetails.Draft)
                    {
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="StartAsync">@Localizer["Receiving.Start"]</MudButton>
                    }
                    @if (_order.Status == ReceivingOrderStatusDetails.InProgress && _order.TotalRemainingQuantity == 0)
                    {
                        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="_saving" OnClick="CompleteAsync">@Localizer["Common.Complete"]</MudButton>
                    }
                </MudStack>
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(_message)) { <MudAlert Severity="Severity.Info">@_message</MudAlert> }
            @if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
            <MudPaper Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="4"><MudText Typo="Typo.caption">@Localizer["Common.Warehouse"]</MudText><MudText>@_order.Warehouse.Code - @_order.Warehouse.Name</MudText></MudItem>
                    <MudItem xs="12" md="4"><MudText Typo="Typo.caption">@Localizer["Receiving.Location"]</MudText><MudText>@_order.ReceivingLocation.Code - @_order.ReceivingLocation.Name</MudText></MudItem>
                    <MudItem xs="4"><MudText Typo="Typo.caption">@Localizer["Receiving.Planned"]</MudText><MudText>@_order.TotalPlannedQuantity.ToString("0.####")</MudText></MudItem>
                    <MudItem xs="4"><MudText Typo="Typo.caption">@Localizer["Receiving.Received"]</MudText><MudText>@_order.TotalReceivedQuantity.ToString("0.####")</MudText></MudItem>
                    <MudItem xs="4"><MudText Typo="Typo.caption">@Localizer["Receiving.Remaining"]</MudText><MudText>@_order.TotalRemainingQuantity.ToString("0.####")</MudText></MudItem>
                    @if (_order.InventoryTransactionId.HasValue)
                    {
                        <MudItem xs="12"><MudButton Variant="Variant.Text" OnClick="OpenTransactionAsync">@Localizer["Receiving.Transaction"]: @_order.InventoryTransactionId.Value</MudButton></MudItem>
                    }
                </MudGrid>
            </MudPaper>
            <MudTable Items="_order.Lines" Dense="true" Bordered="true" Hover="true">
                <HeaderContent><MudTh>@Localizer["Common.Sku"]</MudTh><MudTh>@Localizer["Receiving.Planned"]</MudTh><MudTh>@Localizer["Receiving.Received"]</MudTh><MudTh>@Localizer["Receiving.Remaining"]</MudTh><MudTh>@Localizer["Common.Actions"]</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Sku.Code - @context.Sku.Name</MudTd><MudTd>@context.PlannedQuantity.ToString("0.####")</MudTd><MudTd>@context.ReceivedQuantity.ToString("0.####")</MudTd><MudTd>@context.RemainingQuantity.ToString("0.####")</MudTd>
                    <MudTd>@if (_order.Status == ReceivingOrderStatusDetails.InProgress && context.RemainingQuantity > 0) { <MudButton Size="Size.Small" OnClick="@(() => ReceiveAsync(context))">@Localizer["Receiving.Receive"]</MudButton> }</MudTd>
                </RowTemplate>
            </MudTable>
        </MudStack>
    }
</MudContainer>

@code {
    [Parameter] public Guid ReceivingOrderId { get; set; }
    private ReceivingOrderDetails? _order;
    private bool _loading;
    private bool _saving;
    private string? _error;
    private string? _message;

    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try { _order = await ReceivingApiClient.GetReceivingOrderByIdAsync(ReceivingOrderId); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private async Task StartAsync() => await ExecuteAsync(() => ReceivingApiClient.TryStartReceivingOrderAsync(_order!.Id, new(_order.OrderVersion)), Localizer["Receiving.Started"]);
    private async Task CompleteAsync() => await ExecuteAsync(() => ReceivingApiClient.TryCompleteReceivingOrderAsync(_order!.Id, new(_order.OrderVersion)), Localizer["Receiving.Completed"]);

    private async Task ExecuteAsync(Func<Task<ApiResult<ReceivingOrderDetails>>> action, string success)
    {
        _saving = true; _error = null;
        ApiResult<ReceivingOrderDetails> result = await action();
        _saving = false;
        if (result.IsFailure || result.Value is null)
        {
            if (result.Error?.Status == StatusCodes.Status409Conflict) { await LoadAsync(); _message = Localizer["Receiving.ConflictReloaded"]; }
            else { _error = result.Error?.Message ?? Localizer["Receiving.ActionError"]; }
            return;
        }
        _order = result.Value; _message = success;
    }

    private async Task ReceiveAsync(ReceivingOrderLineDetails line)
    {
        DialogParameters parameters = new() { [nameof(ReceiveReceivingOrderLineDialog.Order)] = _order!, [nameof(ReceiveReceivingOrderLineDialog.Line)] = line };
        IDialogReference dialog = await DialogService.ShowAsync<ReceiveReceivingOrderLineDialog>(Localizer["Receiving.Receive"].Value, parameters, new() { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: ReceivingOrderDetails updated }) { _order = updated; return; }
        if (result?.Data as string == ReceiveReceivingOrderLineDialog.ConflictResult) { await LoadAsync(); _message = Localizer["Receiving.ConflictReloaded"]; }
    }

    private async Task OpenTransactionAsync()
    {
        if (_order?.InventoryTransactionId is not Guid transactionId) return;
        try
        {
            InventoryTransactionDetails transaction = await InventoryApiClient.GetInventoryTransactionByIdAsync(transactionId);
            DialogParameters parameters = new() { [nameof(InventoryTransactionDetailsDialog.Transaction)] = transaction };
            await DialogService.ShowAsync<InventoryTransactionDetailsDialog>(Localizer["Receiving.Transaction"].Value, parameters, new() { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large });
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private string FormatStatus(string status) => status switch
    {
        ReceivingOrderStatusDetails.Draft => Localizer["Receiving.Status.Draft"],
        ReceivingOrderStatusDetails.InProgress => Localizer["Receiving.Status.InProgress"],
        ReceivingOrderStatusDetails.Completed => Localizer["Receiving.Status.Completed"],
        _ => status
    };
}
