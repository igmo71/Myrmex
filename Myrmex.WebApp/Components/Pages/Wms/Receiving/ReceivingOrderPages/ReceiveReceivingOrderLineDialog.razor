@inject WmsReceivingApiClient ReceivingApiClient
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">@Line.Sku.Code - @Line.Sku.Name</MudText>
            <MudText>@Localizer["Sku.BaseUnitOfMeasure"]: @BaseUnitOfMeasureDisplay</MudText>
            <MudText>@Localizer["Receiving.Planned"]: @WmsDisplayFormatter.FormatQuantity(Line.PlannedQuantity)</MudText>
            <MudText>@Localizer["Receiving.Received"]: @WmsDisplayFormatter.FormatQuantity(Line.ReceivedQuantity)</MudText>
            <MudText>@Localizer["Receiving.Remaining"]: @WmsDisplayFormatter.FormatQuantity(Line.RemainingQuantity)</MudText>
            <MudNumericField T="decimal"
                             Label="@Localizer["Receiving.ReceiveQuantity"]"
                             Variant="Variant.Outlined"
                             Validation="@((Func<decimal, string?>)ValidatePositiveQuantity)"
                             Max="@Line.RemainingQuantity"
                             Format="0.##"
                             Required="true"
                             AutoFocus="true"
                             Disabled="_saving"
                             @bind-Value="_quantity" />
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">@Localizer["Common.Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(!CanSave)">
            @Localizer["Receiving.Receive"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public const string ConflictResult = "ReceivingOrderConflict";
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public ReceivingOrderDetails Order { get; set; } = null!;
    [Parameter, EditorRequired] public ReceivingOrderLineDetails Line { get; set; } = null!;
    private decimal _quantity;
    private bool _saving;
    private string? _error;
    private bool CanSave => !_saving && _quantity > 0 && _quantity <= Line.RemainingQuantity;
    private string BaseUnitOfMeasureDisplay =>
        string.IsNullOrWhiteSpace(Line.Sku.BaseUom.Symbol)
            ? Line.Sku.BaseUom.Code
            : Line.Sku.BaseUom.Symbol;

    protected override void OnInitialized() => _quantity = Line.RemainingQuantity;

    private async Task SaveAsync()
    {
        if (_quantity <= 0 || _quantity > Line.RemainingQuantity) { _error = Localizer["Receiving.QuantityInvalid"]; return; }
        _saving = true;
        _error = null;
        try
        {
            ApiResult<ReceivingOrderDetails> result = await ReceivingApiClient.TryReceiveLineAsync(
                Order.Id, Line.Id, new(_quantity, Order.OrderVersion));
            if (result.IsFailure)
            {
                if (result.Error?.Status == StatusCodes.Status409Conflict) { MudDialog.Close(DialogResult.Ok(ConflictResult)); return; }
                _error = result.Error?.Message ?? Localizer["Receiving.ReceiveError"];
                return;
            }
            if (result.Value is not null) { MudDialog.Close(DialogResult.Ok(result.Value)); }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    protected string? ValidatePositiveQuantity(decimal quantity) =>
        quantity > 0 ? null : Localizer["Common.QuantityMustBePositive"].Value;
}
