@page "/wms/inventory/counts/{InventoryCountId:guid}"
@using Myrmex.Shared.Wms.Inventory
@using Myrmex.WebApp.Components.Pages.Wms.Inventory.InventoryLedgerPages
@inject WmsInventoryApiClient WmsInventoryApiClient
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["InventoryCount.DetailsPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else if (_count is not null)
    {
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.h5">@Localizer["InventoryCount.DetailsHeading"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @WarehouseDisplayFormatter.GetName(_count.Warehouse.Name, Localizer)
                    </MudText>
                </div>
                @if (CanModifyCount)
                {
                    <MudStack Row="true" Spacing="2">
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenAddLineAsync"
                                   Disabled="_isLifecycleSaving">
                            @Localizer["InventoryCount.AddLine"]
                        </MudButton>
                        <MudButton Color="Color.Success"
                                   Variant="Variant.Filled"
                                   OnClick="CompleteCountAsync"
                                   Disabled="@(!CanCompleteCount || _isLifecycleSaving)">
                            @Localizer["Common.Complete"]
                        </MudButton>
                        <MudButton Color="Color.Error"
                                   Variant="Variant.Outlined"
                                   OnClick="CancelCountAsync"
                                   Disabled="_isLifecycleSaving">
                            @Localizer["Common.Cancel"]
                        </MudButton>
                    </MudStack>
                }
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_actionMessage))
            {
                <MudAlert Severity="Severity.Info">@_actionMessage</MudAlert>
            }

            <MudPaper Class="pa-4" Outlined="true">
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.caption">@Localizer["Common.Status"]</MudText>
                        <MudText>@_count.Status</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.caption">@Localizer["Common.Created"]</MudText>
                        <MudText>@_count.CreatedAtUtc.ToLocalTime().ToString("g")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.caption">@Localizer["Common.CreatedBy"]</MudText>
                        <MudText>@_count.CreatedByActorId</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.caption">@Localizer["Common.Reason"]</MudText>
                        <MudText>@(_count.Reason ?? "—")</MudText>
                    </MudItem>
                    @if (_count.CompletedAtUtc.HasValue)
                    {
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption">@Localizer["Common.Completed"]</MudText>
                            <MudText>
                                @Localizer["InventoryCount.TimestampByActor", _count.CompletedAtUtc.Value.ToLocalTime().ToString("g"), _count.CompletedByActorId ?? string.Empty]
                            </MudText>
                        </MudItem>
                    }
                    @if (_count.CancelledAtUtc.HasValue)
                    {
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption">@Localizer["Common.Cancelled"]</MudText>
                            <MudText>
                                @Localizer["InventoryCount.TimestampByActor", _count.CancelledAtUtc.Value.ToLocalTime().ToString("g"), _count.CancelledByActorId ?? string.Empty]
                            </MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <MudTable Items="_count.Lines" Dense="true" Hover="true" Bordered="true">
                <HeaderContent>
                    <MudTh>@Localizer["Common.Sku"]</MudTh>
                    <MudTh>@Localizer["Common.Location"]</MudTh>
                    <MudTh>@Localizer["InventoryCount.SystemQuantity"]</MudTh>
                    <MudTh>@Localizer["InventoryBalance.CountedQuantity"]</MudTh>
                    <MudTh>@Localizer["InventoryCount.Variance"]</MudTh>
                    <MudTh>@Localizer["Common.Status"]</MudTh>
                    <MudTh>@Localizer["InventoryCount.CountEvidence"]</MudTh>
                    <MudTh>@Localizer["InventoryCount.ApplyEvidence"]</MudTh>
                    <MudTh>@Localizer["Common.Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @context.Sku.Code - @context.Sku.Name
                        <MudText Typo="Typo.caption">@FormatUom(context)</MudText>
                    </MudTd>
                    <MudTd>@context.StorageLocation.Code - @context.StorageLocation.Name</MudTd>
                    <MudTd>@context.SystemQuantity</MudTd>
                    <MudTd>@(context.CountedQuantity?.ToString() ?? "—")</MudTd>
                    <MudTd>@(context.VarianceQuantity?.ToString() ?? "—")</MudTd>
                    <MudTd>@context.Status</MudTd>
                    <MudTd>
                        @if (context.CountedAtUtc.HasValue)
                        {
                            <MudText Typo="Typo.body2">@context.CountedByActorId</MudText>
                            <MudText Typo="Typo.caption">
                                @context.CountedAtUtc.Value.ToLocalTime().ToString("g")
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(context.Comment))
                            {
                                <MudText Typo="Typo.caption">@context.Comment</MudText>
                            }
                        }
                        else
                        {
                            <MudText>—</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.AppliedAtUtc.HasValue)
                        {
                            <MudText Typo="Typo.body2">@context.AppliedByActorId</MudText>
                            <MudText Typo="Typo.caption">
                                @context.AppliedAtUtc.Value.ToLocalTime().ToString("g")
                            </MudText>
                        }
                        @if (context.AppliedInventoryTransactionId.HasValue)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       OnClick="@(() => OpenTransactionAsync(context.AppliedInventoryTransactionId.Value))">
                                @Localizer["InventoryCount.ViewAdjustment"]
                            </MudButton>
                        }
                        @if (context.SupersedesInventoryCountLineId.HasValue)
                        {
                            <MudText Typo="Typo.caption">
                                @Localizer["InventoryCount.Replaces", context.SupersedesInventoryCountLineId]
                            </MudText>
                        }
                        @if (context.ReplacementInventoryCountLineId.HasValue)
                        {
                            <MudText Typo="Typo.caption">
                                @Localizer["InventoryCount.ReplacedBy", context.ReplacementInventoryCountLineId]
                            </MudText>
                        }
                    </MudTd>
                    <MudTd>
                        @if (CanRecordLine(context))
                        {
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Variant="Variant.Text"
                                       OnClick="@(() => OpenRecordCountAsync(context))">
                                @(context.Status == InventoryCountLineStatusDetails.Counted
                                    ? Localizer["InventoryCount.EditCount"]
                                    : Localizer["InventoryCount.EnterCount"])
                            </MudButton>
                        }
                        @if (CanModifyCount &&
                             context.Status == InventoryCountLineStatusDetails.Counted)
                        {
                            <MudButton Size="Size.Small"
                                       Color="Color.Success"
                                       Variant="Variant.Text"
                                       OnClick="@(() => ApplyLineAsync(context))">
                                @Localizer["Common.Apply"]
                            </MudButton>
                        }
                        @if (CanModifyCount &&
                             context.Status == InventoryCountLineStatusDetails.Conflict)
                        {
                            <MudButton Size="Size.Small"
                                       Color="Color.Warning"
                                       Variant="Variant.Text"
                                       OnClick="@(() => SupersedeLineAsync(context))">
                                @Localizer["InventoryCount.Supersede"]
                            </MudButton>
                        }
                        @if (CanModifyCount &&
                             context.Status == InventoryCountLineStatusDetails.Pending)
                        {
                            <MudButton Size="Size.Small"
                                       Color="Color.Error"
                                       Variant="Variant.Text"
                                       OnClick="@(() => RemoveLineAsync(context))">
                                @Localizer["Common.Remove"]
                            </MudButton>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@Localizer["InventoryCount.NoLines"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudStack>
    }
</MudContainer>

    @code {
    [Parameter]
    public Guid InventoryCountId { get; set; }

    private InventoryCountDetails? _count;
    private bool _isLoading;
    private bool _isLifecycleSaving;
    private string? _errorMessage;
    private string? _actionMessage;

    private bool CanModifyCount =>
        _count?.Status is InventoryCountStatusDetails.Draft
            or InventoryCountStatusDetails.InProgress;

    private bool CanCompleteCount =>
        _count is not null &&
        _count.Lines.Any(x => x.IsCurrent) &&
        _count.Lines
            .Where(x => x.IsCurrent)
            .All(x => x.Status == InventoryCountLineStatusDetails.Applied);

    private bool HasAppliedAdjustments =>
        _count?.Lines.Any(x =>
            x.Status == InventoryCountLineStatusDetails.Applied &&
            x.AppliedInventoryTransactionId.HasValue) == true;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _count = await WmsInventoryApiClient.GetInventoryCountByIdAsync(InventoryCountId);
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenAddLineAsync()
    {
        if (_count is null)
        {
            return;
        }

        DialogParameters parameters = new()
        {
            [nameof(AddInventoryCountLineDialog.Count)] = _count
        };
        IDialogReference dialog = await DialogService.ShowAsync<AddInventoryCountLineDialog>(
            Localizer["InventoryCount.AddLineTitle"],
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium });
        DialogResult? result = await dialog.Result;

        if (result is not null &&
            !result.Canceled &&
            result.Data is InventoryCountDetails updated)
        {
            _count = updated;
            _actionMessage = null;
        }
    }

    private async Task OpenRecordCountAsync(InventoryCountLineDetails countLine)
    {
        if (_count is null)
        {
            return;
        }

        DialogParameters parameters = new()
        {
            [nameof(RecordInventoryCountLineDialog.Count)] = _count,
            [nameof(RecordInventoryCountLineDialog.CountLine)] = countLine
        };
        IDialogReference dialog = await DialogService.ShowAsync<RecordInventoryCountLineDialog>(
            countLine.Status == InventoryCountLineStatusDetails.Counted
                ? Localizer["InventoryCount.EditPhysicalCount"]
                : Localizer["InventoryCount.EnterPhysicalCount"],
            parameters,
            new DialogOptions
            {
                CloseButton = true,
                FullWidth = true,
                MaxWidth = MaxWidth.Small
            });
        DialogResult? result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is InventoryCountDetails updated)
        {
            _count = updated;
            _errorMessage = null;
            _actionMessage = Localizer["InventoryCount.PhysicalCountRecorded"];
            return;
        }

        if (result.Data is string outcome &&
            outcome == RecordInventoryCountLineDialog.StaleResult)
        {
            await LoadAsync();
            _actionMessage = Localizer["InventoryCount.LineChangedRefresh"];
        }
    }

    private async Task RemoveLineAsync(InventoryCountLineDetails line)
    {
        if (_count is null)
        {
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            Localizer["InventoryCount.RemoveLineTitle"],
            Localizer["InventoryCount.RemoveLinePrompt", line.Sku.Code, line.StorageLocation.Code],
            yesText: Localizer["Common.Remove"],
            cancelText: Localizer["Common.Cancel"]);

        if (confirmed != true)
        {
            return;
        }

        ApiResult<InventoryCountDetails> result =
            await WmsInventoryApiClient.TryRemoveInventoryCountLineAsync(
                _count.Id,
                line.Id,
                line.LineVersion);

        if (result.IsFailure || result.Value is null)
        {
            _errorMessage = result.Error?.Message ?? Localizer["InventoryCount.RemoveLineError"];
            return;
        }

        _count = result.Value;
        _actionMessage = null;
    }

    private async Task ApplyLineAsync(InventoryCountLineDetails line)
    {
        if (_count is null)
        {
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            Localizer["InventoryCount.ApplyResultTitle"],
            line.VarianceQuantity == 0
                ? Localizer["InventoryCount.ApplyZeroVariancePrompt"]
                : Localizer["InventoryCount.ApplyVariancePrompt", $"{line.VarianceQuantity:+0.####;-0.####;0}", $"{line.CountedQuantity:0.####}"],
            yesText: Localizer["Common.Apply"],
            cancelText: Localizer["Common.Cancel"]);
        if (confirmed != true)
        {
            return;
        }

        ApiResult<InventoryCountDetails> result =
            await WmsInventoryApiClient.TryApplyInventoryCountLineAsync(
                _count.Id,
                line.Id,
                new ApplyInventoryCountLineRequest(line.LineVersion));
        if (result.IsFailure)
        {
            await LoadAsync();
            if (result.Error?.Status == StatusCodes.Status409Conflict)
            {
                _actionMessage = Localizer["InventoryCount.ApplyConflictRefresh"];
                _errorMessage = null;
            }
            else
            {
                _actionMessage = null;
                _errorMessage = result.Error?.Message ?? Localizer["InventoryCount.ApplyError"];
            }            
            return;
        }

        if (result.Value is null)
        {
            _errorMessage = Localizer["InventoryCount.MissingResult"];
            return;
        }

        _count = result.Value;
        InventoryCountLineDetails applied = _count.Lines.Single(x => x.Id == line.Id);
        _actionMessage = applied.AppliedInventoryTransactionId.HasValue
            ? Localizer["InventoryCount.InventoryAdjusted", $"{applied.CountedQuantity:0.####}", applied.AppliedInventoryTransactionId]
            : Localizer["InventoryCount.ZeroVarianceConfirmed"];
        _errorMessage = null;
    }

    private async Task SupersedeLineAsync(InventoryCountLineDetails line)
    {
        if (_count is null)
        {
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            Localizer["InventoryCount.SupersedeTitle"],
            Localizer["InventoryCount.SupersedePrompt"],
            yesText: Localizer["InventoryCount.Supersede"],
            cancelText: Localizer["Common.Cancel"]);
        if (confirmed != true)
        {
            return;
        }

        ApiResult<InventoryCountDetails> result =
            await WmsInventoryApiClient.TrySupersedeInventoryCountLineAsync(
                _count.Id,
                line.Id,
                new SupersedeInventoryCountLineRequest(line.LineVersion));
        if (result.IsFailure || result.Value is null)
        {
            await LoadAsync();
            _errorMessage = result.Error?.Message ?? Localizer["InventoryCount.SupersedeError"];
            return;
        }

        _count = result.Value;
        InventoryCountLineDetails replacement = _count.Lines.Single(
            x => x.SupersedesInventoryCountLineId == line.Id);
        _actionMessage = Localizer["InventoryCount.Superseded", $"{replacement.SystemQuantity:0.####}"];
        _errorMessage = null;
    }

    private async Task OpenTransactionAsync(Guid transactionId)
    {
        try
        {
            InventoryTransactionDetails transaction =
                await WmsInventoryApiClient.GetInventoryTransactionByIdAsync(transactionId);
            DialogParameters parameters = new()
            {
                [nameof(InventoryTransactionDetailsDialog.Transaction)] = transaction
            };
            await DialogService.ShowAsync<InventoryTransactionDetailsDialog>(
                Localizer["InventoryCount.InventoryTransactionTitle"],
                parameters,
                new DialogOptions
                {
                    CloseButton = true,
                    FullWidth = true,
                    MaxWidth = MaxWidth.Large
                });
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task CompleteCountAsync()
    {
        if (_count is null || !CanCompleteCount)
        {
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            Localizer["InventoryCount.CompleteTitle"],
            Localizer["InventoryCount.CompletePrompt"],
            yesText: Localizer["Common.Complete"],
            cancelText: Localizer["Common.Cancel"]);
        if (confirmed != true)
        {
            return;
        }

        _isLifecycleSaving = true;
        try
        {
            ApiResult<InventoryCountDetails> result =
                await WmsInventoryApiClient.TryCompleteInventoryCountAsync(
                    _count.Id,
                    new ChangeInventoryCountStatusRequest(_count.CountVersion));
            if (result.IsFailure || result.Value is null)
            {
                await LoadAsync();
                _errorMessage = result.Error?.Message ?? Localizer["InventoryCount.CompleteError"];
                return;
            }

            _count = result.Value;
            _actionMessage = Localizer["InventoryCount.CompletedReadOnly"];
            _errorMessage = null;
        }
        finally
        {
            _isLifecycleSaving = false;
        }
    }

    private async Task CancelCountAsync()
    {
        if (_count is null)
        {
            return;
        }

        string message = HasAppliedAdjustments
            ? Localizer["InventoryCount.CancelAppliedPrompt"]
            : Localizer["InventoryCount.CancelPrompt"];
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            Localizer["InventoryCount.CancelTitle"],
            message,
            yesText: Localizer["InventoryCount.CancelCount"],
            cancelText: Localizer["InventoryCount.KeepOpen"]);
        if (confirmed != true)
        {
            return;
        }

        _isLifecycleSaving = true;
        try
        {
            ApiResult<InventoryCountDetails> result =
                await WmsInventoryApiClient.TryCancelInventoryCountAsync(
                    _count.Id,
                    new ChangeInventoryCountStatusRequest(_count.CountVersion));
            if (result.IsFailure || result.Value is null)
            {
                await LoadAsync();
                _errorMessage = result.Error?.Message ?? Localizer["InventoryCount.CancelError"];
                return;
            }

            _count = result.Value;
            _actionMessage = HasAppliedAdjustments
                ? Localizer["InventoryCount.CancelledAppliedEffective"]
                : Localizer["InventoryCount.Cancelled"];
            _errorMessage = null;
        }
        finally
        {
            _isLifecycleSaving = false;
        }
    }

    private bool CanRecordLine(InventoryCountLineDetails countLine) =>
        CanModifyCount &&
        countLine.Status is InventoryCountLineStatusDetails.Pending
            or InventoryCountLineStatusDetails.Counted;

    private static string FormatUom(InventoryCountLineDetails line) =>
        string.IsNullOrWhiteSpace(line.Sku.BaseUom.Symbol)
            ? line.Sku.BaseUom.Code
            : $"{line.Sku.BaseUom.Code} ({line.Sku.BaseUom.Symbol})";
}
