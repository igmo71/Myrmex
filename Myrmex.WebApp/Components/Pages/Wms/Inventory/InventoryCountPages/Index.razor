@page "/wms/inventory/counts"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["InventoryCount.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">@Localizer["InventoryCount.Heading"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["InventoryCount.Description"]
                </MudText>
            </div>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                @Localizer["InventoryCount.Create"]
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        <InventoryCountFilters SelectedWarehouse="@_selectedWarehouse"
                               SelectedWarehouseChanged="OnWarehouseChanged"
                               SearchWarehouses="SearchWarehousesAsync"
                               SelectedStatus="@_selectedStatus"
                               SelectedStatusChanged="OnStatusChanged"
                               CreatedFrom="@_createdFrom"
                               CreatedFromChanged="OnCreatedFromChanged"
                               CreatedTo="@_createdTo"
                               CreatedToChanged="OnCreatedToChanged"
                               ReloadRequested="ReloadAsync" />

        <InventoryCountGrid @ref="_inventoryCountGrid"
                            LoadData="LoadInventoryCountsAsync"
                            OpenRequested="OpenAsync"
                            CancelRequested="CancelAsync" />
    </MudStack>
</MudContainer>
