@using Myrmex.Shared.Common
@using Myrmex.Shared.Wms.Inventory
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["InventoryCount.CreateTitle"]</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudAutocomplete T="WarehouseLookupItem"
                                 Label="@Localizer["Common.Warehouse"]"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 RequiredError="@Localizer["Common.WarehouseRequired"]"
                                 Clearable="true"
                                 ShowProgressIndicator="true"
                                 MinCharacters="0"
                                 DebounceInterval="300"
                                 MaxItems="20"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 Value="_selectedWarehouse"
                                 ValueChanged="OnWarehouseChanged"
                                 SearchFunc="SearchWarehousesAsync"
                                 ToStringFunc="FormatWarehouse">
                    <ItemTemplate>
                        <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <MudText>@Localizer["Warehouse.NoneFound"]</MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>

                <MudTextField T="string"
                              Label="@Localizer["InventoryCount.ReasonOrDescription"]"
                              Variant="Variant.Outlined"
                              Lines="3"
                              MaxLength="500"
                              @bind-Value="_reason" />

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSaving">@Localizer["Common.Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="_isSaving">
            @Localizer["Common.Create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private WmsTopologyApiClient WmsTopologyApiClient { get; set; } = null!;

    [Inject]
    private WmsInventoryApiClient WmsInventoryApiClient { get; set; } = null!;

    private MudForm? _form;
    private const int AutocompleteTake = 20;

    private WarehouseLookupItem? _selectedWarehouse;
    private Guid? _warehouseId;
    private string? _reason;
    private string? _errorMessage;
    private bool _isSaving;

    private async Task<IEnumerable<WarehouseLookupItem>> SearchWarehousesAsync(
        string value,
        CancellationToken cancellationToken)
    {
        try
        {
            return await WmsTopologyApiClient.LookupWarehousesAsync(
                new LookupWarehousesRequest
                {
                    SearchText = value,
                    Take = AutocompleteTake,
                    SelectableOnly = true
                },
                cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            return [];
        }
    }

    private Task OnWarehouseChanged(WarehouseLookupItem? value)
    {
        _selectedWarehouse = value;
        _warehouseId = value?.Id;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            ApiResult<InventoryCountDetails> result =
                await WmsInventoryApiClient.TryCreateInventoryCountAsync(
                    new CreateInventoryCountRequest(_warehouseId, _reason));

            if (result.IsFailure || result.Value is null)
            {
                _errorMessage = result.Error?.Message ?? Localizer["InventoryCount.CreateError"];
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static string FormatWarehouse(WarehouseLookupItem? warehouse) =>
        warehouse is null ? string.Empty : $"{warehouse.Code} - {warehouse.Name}";
}
