@using Myrmex.Shared.Wms.Inventory
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
        <MudAutocomplete T="WarehouseLookupItem"
                         Label="@Localizer["Common.Warehouse"]"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Clearable="true"
                         ShowProgressIndicator="true"
                         MinCharacters="0"
                         DebounceInterval="300"
                         MaxItems="20"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         CoerceValue="false"
                         Value="SelectedWarehouse"
                         ValueChanged="OnWarehouseChanged"
                         SearchFunc="SearchWarehouses"
                         ToStringFunc="FormatWarehouse"
                         HelperText="&#160;"
                         Class="min-width-300">
            <ItemTemplate>
                <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText>@Localizer["Warehouse.NoneFound"]</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
        <MudSelect T="string"
                   Label="@Localizer["Common.Status"]"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   Value="SelectedStatus"
                   ValueChanged="OnStatusChanged"
                   HelperText="&#160;"
                   Class="min-width-220">
            <MudSelectItem T="string" Value="@InventoryCountStatusDetails.Draft">@Localizer["InventoryCount.Draft"]</MudSelectItem>
            <MudSelectItem T="string" Value="@InventoryCountStatusDetails.InProgress">@Localizer["Common.InProgress"]</MudSelectItem>
            <MudSelectItem T="string" Value="@InventoryCountStatusDetails.Completed">@Localizer["Common.Completed"]</MudSelectItem>
            <MudSelectItem T="string" Value="@InventoryCountStatusDetails.Cancelled">@Localizer["Common.Cancelled"]</MudSelectItem>
        </MudSelect>
        <MudDatePicker Label="@Localizer["Common.CreatedFrom"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Date="CreatedFrom"
                       DateChanged="OnCreatedFromChanged"
                       Clearable="true"
                       HelperText="&#160;"
                       Class="min-width-220" />
        <MudDatePicker Label="@Localizer["Common.CreatedTo"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Date="CreatedTo"
                       DateChanged="OnCreatedToChanged"
                       Clearable="true"
                       HelperText="&#160;"
                       Class="min-width-220" />
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnReloadRequested">
            @Localizer["Common.Refresh"]
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public WarehouseLookupItem? SelectedWarehouse { get; set; }
    [Parameter] public EventCallback<WarehouseLookupItem?> SelectedWarehouseChanged { get; set; }
    [Parameter]
    public Func<string, CancellationToken, Task<IEnumerable<WarehouseLookupItem>>> SearchWarehouses { get; set; } =
        (_, _) => Task.FromResult(Enumerable.Empty<WarehouseLookupItem>());
    [Parameter] public string? SelectedStatus { get; set; }
    [Parameter] public EventCallback<string?> SelectedStatusChanged { get; set; }
    [Parameter] public DateTime? CreatedFrom { get; set; }
    [Parameter] public EventCallback<DateTime?> CreatedFromChanged { get; set; }
    [Parameter] public DateTime? CreatedTo { get; set; }
    [Parameter] public EventCallback<DateTime?> CreatedToChanged { get; set; }
    [Parameter] public EventCallback ReloadRequested { get; set; }

    private Task OnWarehouseChanged(WarehouseLookupItem? value) =>
        SelectedWarehouseChanged.InvokeAsync(value);
    private Task OnStatusChanged(string? value) =>
        SelectedStatusChanged.InvokeAsync(value);
    private Task OnCreatedFromChanged(DateTime? value) =>
        CreatedFromChanged.InvokeAsync(value);
    private Task OnCreatedToChanged(DateTime? value) =>
        CreatedToChanged.InvokeAsync(value);
    private Task OnReloadRequested() => ReloadRequested.InvokeAsync();

    private static string FormatWarehouse(WarehouseLookupItem? warehouse) =>
        warehouse is null ? string.Empty : $"{warehouse.Code} - {warehouse.Name}";
}
