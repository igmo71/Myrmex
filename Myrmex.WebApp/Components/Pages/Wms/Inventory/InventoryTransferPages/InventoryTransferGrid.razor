@using Myrmex.Shared.Wms.Inventory
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="InventoryTransferListItem"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Single"
             Filterable="false">
    <Columns>
        <TemplateColumn Title="@Localizer["InventoryTransfer.Transfer"]"
                        Tag="@InventoryTransferSortBy.Code"
                        SortBy="@(transfer => transfer.Code)"
                        Sortable="true">
            <CellTemplate>
                <MudText Typo="Typo.body2">@context.Item.Code</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @WmsDisplayFormatter.FormatLocalDateTime(context.Item.CreatedAtUtc)
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Warehouse"]"
                        Sortable="false">
            <CellTemplate>
                <WmsReference Name="@context.Item.SourceWarehouse.Name" Code="@context.Item.SourceWarehouse.Code" />
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["InventoryTransfer.Transit"]">
            <CellTemplate>
                @(context.Item.TransitStorageLocation?.Code ?? Localizer["InventoryTransfer.Direct"])
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="@(transfer => transfer.TotalRequestedQuantity)"
                        Title="@Localizer["InventoryTransfer.Requested"]"
                        SortBy="@(transfer => transfer.TotalRequestedQuantity)"
                        Format="0.##" />

        @* <TemplateColumn Title="@Localizer["InventoryTransfer.Requested"]"
                        Tag="@InventoryTransferSortBy.TotalRequestedQuantity"
                        SortBy="@(transfer => transfer.TotalRequestedQuantity)"
                        Sortable="true">
            <CellTemplate>
                @context.Item.TotalRequestedQuantity
            </CellTemplate>
        </TemplateColumn> *@

        <TemplateColumn Title="@Localizer["InventoryTransfer.Picked"]"
                        Tag="@InventoryTransferSortBy.TotalPickedQuantity"
                        SortBy="@(transfer => transfer.TotalPickedQuantity)"
                        Sortable="true">
            <CellTemplate>
                @WmsDisplayFormatter.FormatQuantity(context.Item.TotalPickedQuantity)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["InventoryTransfer.Placed"]"
                        Tag="@InventoryTransferSortBy.TotalPlacedQuantity"
                        SortBy="@(transfer => transfer.TotalPlacedQuantity)"
                        Sortable="true">
            <CellTemplate>
                @WmsDisplayFormatter.FormatQuantity(context.Item.TotalPlacedQuantity)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["InventoryTransfer.InTransit"]"
                        Tag="@InventoryTransferSortBy.TotalInTransitQuantity"
                        SortBy="@(transfer => transfer.TotalInTransitQuantity)"
                        Sortable="true">
            <CellTemplate>
                @WmsDisplayFormatter.FormatQuantity(context.Item.TotalInTransitQuantity)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Status"]"
                        Tag="@InventoryTransferSortBy.Status"
                        SortBy="@(transfer => transfer.Status)"
                        Sortable="true">
            <CellTemplate>
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@GetStatusColor(context.Item.Status)">
                    @WmsDisplayFormatter.FormatTransferStatus(context.Item.Status, Localizer)
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Actions"]" Sortable="false">
            <CellTemplate>
                <MudTooltip Text="@GetActionTitle(context.Item)">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                   Size="Size.Small"
                                   aria-label="@GetActionTitle(context.Item)"
                                   OnClick="@(() => DetailsRequested.InvokeAsync(context.Item))" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <NoRecordsContent>
        <MudText>@Localizer["InventoryTransfer.NoMatches"]</MudText>
    </NoRecordsContent>

    <PagerContent>
        <MudDataGridPager T="InventoryTransferListItem" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public Func<InventoryTransferGridRequest, CancellationToken, Task<GridData<InventoryTransferListItem>>> LoadData { get; set; } = default!;

    [Parameter]
    public EventCallback<InventoryTransferListItem> DetailsRequested { get; set; }

    private MudDataGrid<InventoryTransferListItem>? _dataGrid;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private Task<GridData<InventoryTransferListItem>> LoadServerDataAsync(
        GridState<InventoryTransferListItem> state,
        CancellationToken cancellationToken)
    {
        SortDefinition<InventoryTransferListItem>? sortDefinition =
            state.SortDefinitions.FirstOrDefault();

        InventoryTransferGridRequest request = new(
            Skip: state.Page * state.PageSize,
            Take: state.PageSize,
            SortBy: ResolveSortBy(sortDefinition),
            SortDescending: sortDefinition?.Descending ?? true);

        return LoadData(request, cancellationToken);
    }

    private string ResolveSortBy(SortDefinition<InventoryTransferListItem>? sortDefinition)
    {
        if (sortDefinition is null)
        {
            return InventoryTransferSortBy.CreatedAtUtc;
        }

        Column<InventoryTransferListItem>? column =
            _dataGrid?.GetColumnByPropertyName(sortDefinition.SortBy);

        return column?.Tag as string
            ?? InventoryTransferSortBy.CreatedAtUtc;
    }

    public async Task ReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        await _dataGrid.ReloadServerData();
    }

    public async Task ResetAndReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        if (_dataGrid.CurrentPage == 0)
        {
            await _dataGrid.ReloadServerData();
            return;
        }

        _dataGrid.NavigateTo(Page.First);
    }

    private static Color GetStatusColor(string status)
    {
        return status switch
        {
            InventoryTransferStatusDetails.Created => Color.Default,
            InventoryTransferStatusDetails.InProgress => Color.Warning,
            InventoryTransferStatusDetails.Completed => Color.Success,
            _ => Color.Default
        };
    }

    private string GetActionTitle(InventoryTransferListItem transfer)
    {
        return transfer.Status == InventoryTransferStatusDetails.Completed
            ? Localizer["InventoryTransfer.View"]
            : Localizer["InventoryTransfer.Open"];
    }
}
