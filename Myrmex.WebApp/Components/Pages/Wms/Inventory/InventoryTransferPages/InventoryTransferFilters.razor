@using Myrmex.Shared.Wms.Catalog
@using Myrmex.Shared.Wms.Inventory
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudPaper Class="pa-4">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
            <MudSelect T="Guid?"
                       Label="@Localizer["Common.Warehouse"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Value="SelectedWarehouseId"
                       ValueChanged="OnWarehouseChanged"
                       Disabled="IsLoadingWarehouses"
                       HelperText="&#160;"
                       Class="min-width-300">
                @foreach (WarehouseDetails warehouse in Warehouses)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)warehouse.Id)">
                        @warehouse.Code - @warehouse.Name
                    </MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       Label="@Localizer["Common.Status"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Value="SelectedStatus"
                       ValueChanged="OnStatusChanged"
                       HelperText="&#160;"
                       Class="min-width-220">
                <MudSelectItem T="string" Value="@InventoryTransferStatusDetails.Created">@Localizer["Common.CreatedStatus"]</MudSelectItem>
                <MudSelectItem T="string" Value="@InventoryTransferStatusDetails.InProgress">@Localizer["Common.InProgress"]</MudSelectItem>
                <MudSelectItem T="string" Value="@InventoryTransferStatusDetails.Completed">@Localizer["Common.Completed"]</MudSelectItem>
            </MudSelect>

            <MudSelect T="bool?"
                       Label="@Localizer["InventoryTransfer.Transit"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Value="HasTransitLocation"
                       ValueChanged="OnTransitChanged"
                       HelperText="&#160;"
                       Class="min-width-220">
                <MudSelectItem T="bool?" Value="@((bool?)true)">@Localizer["InventoryTransfer.Transit"]</MudSelectItem>
                <MudSelectItem T="bool?" Value="@((bool?)false)">@Localizer["InventoryTransfer.Direct"]</MudSelectItem>
            </MudSelect>

            <MudTextField T="string"
                          Label="@Localizer["InventoryTransfer.Code"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Value="TransferCode"
                          ValueChanged="OnTransferCodeChanged"
                          DebounceInterval="300"
                          Immediate="false"
                          HelperText="&#160;"
                          Class="min-width-220" />
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
            <MudDatePicker Label="@Localizer["Common.CreatedFrom"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Date="CreatedFrom"
                           DateChanged="OnCreatedFromChanged"
                           Clearable="true"
                           HelperText="&#160;"
                           Class="min-width-220" />

            <MudDatePicker Label="@Localizer["Common.CreatedTo"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Date="CreatedTo"
                           DateChanged="OnCreatedToChanged"
                           Clearable="true"
                           HelperText="&#160;"
                           Class="min-width-220" />

            <MudAutocomplete T="StockKeepingUnitLookupItem"
                             Label="@Localizer["Common.Sku"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             ShowProgressIndicator="true"
                             MinCharacters="0"
                             DebounceInterval="300"
                             MaxItems="20"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false"
                             Value="SelectedStockKeepingUnit"
                             ValueChanged="OnStockKeepingUnitChanged"
                             SearchFunc="SearchStockKeepingUnits"
                             ToStringFunc="FormatStockKeepingUnit"
                             HelperText="&#160;"
                             Class="min-width-300">
                <ItemTemplate>
                    <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                </ItemTemplate>
                <NoItemsTemplate>
                    <MudText>@Localizer["Sku.NoneFound"]</MudText>
                </NoItemsTemplate>
            </MudAutocomplete>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
            <MudAutocomplete T="StorageLocationLookupItem"
                             Label="@Localizer["InventoryTransfer.SourceLocation"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             ShowProgressIndicator="true"
                             MinCharacters="0"
                             DebounceInterval="300"
                             MaxItems="20"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false"
                             Value="SelectedSourceStorageLocation"
                             ValueChanged="OnSourceStorageLocationChanged"
                             SearchFunc="SearchStorageLocations"
                             ToStringFunc="FormatStorageLocation"
                             Disabled="SelectedWarehouseId is null"
                             HelperText="@StorageLocationHelperText"
                             Class="min-width-300">
                <ItemTemplate>
                    <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                </ItemTemplate>
                <NoItemsTemplate>
                    <MudText>@Localizer["StorageLocation.NoneFound"]</MudText>
                </NoItemsTemplate>
            </MudAutocomplete>

            <MudAutocomplete T="StorageLocationLookupItem"
                             Label="@Localizer["InventoryTransfer.DestinationLocation"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             ShowProgressIndicator="true"
                             MinCharacters="0"
                             DebounceInterval="300"
                             MaxItems="20"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false"
                             Value="SelectedDestinationStorageLocation"
                             ValueChanged="OnDestinationStorageLocationChanged"
                             SearchFunc="SearchStorageLocations"
                             ToStringFunc="FormatStorageLocation"
                             Disabled="SelectedWarehouseId is null"
                             HelperText="@StorageLocationHelperText"
                             Class="min-width-300">
                <ItemTemplate>
                    <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                </ItemTemplate>
                <NoItemsTemplate>
                    <MudText>@Localizer["StorageLocation.NoneFound"]</MudText>
                </NoItemsTemplate>
            </MudAutocomplete>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="OnReloadRequested">
                @Localizer["Common.Refresh"]
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public IReadOnlyList<WarehouseDetails> Warehouses { get; set; } = [];

    [Parameter]
    public Guid? SelectedWarehouseId { get; set; }

    [Parameter]
    public EventCallback<Guid?> SelectedWarehouseIdChanged { get; set; }

    [Parameter]
    public string? SelectedStatus { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedStatusChanged { get; set; }

    [Parameter]
    public bool? HasTransitLocation { get; set; }

    [Parameter]
    public EventCallback<bool?> HasTransitLocationChanged { get; set; }

    [Parameter]
    public string? TransferCode { get; set; }

    [Parameter]
    public EventCallback<string?> TransferCodeChanged { get; set; }

    [Parameter]
    public DateTime? CreatedFrom { get; set; }

    [Parameter]
    public EventCallback<DateTime?> CreatedFromChanged { get; set; }

    [Parameter]
    public DateTime? CreatedTo { get; set; }

    [Parameter]
    public EventCallback<DateTime?> CreatedToChanged { get; set; }

    [Parameter]
    public StockKeepingUnitLookupItem? SelectedStockKeepingUnit { get; set; }

    [Parameter]
    public EventCallback<StockKeepingUnitLookupItem?> SelectedStockKeepingUnitChanged { get; set; }

    [Parameter]
    public StorageLocationLookupItem? SelectedSourceStorageLocation { get; set; }

    [Parameter]
    public EventCallback<StorageLocationLookupItem?> SelectedSourceStorageLocationChanged { get; set; }

    [Parameter]
    public StorageLocationLookupItem? SelectedDestinationStorageLocation { get; set; }

    [Parameter]
    public EventCallback<StorageLocationLookupItem?> SelectedDestinationStorageLocationChanged { get; set; }

    [Parameter]
    public bool IsLoadingWarehouses { get; set; }

    [Parameter]
    public Func<string, CancellationToken, Task<IEnumerable<StockKeepingUnitLookupItem>>> SearchStockKeepingUnits { get; set; } =
        (_, _) => Task.FromResult(Enumerable.Empty<StockKeepingUnitLookupItem>());

    [Parameter]
    public Func<string, CancellationToken, Task<IEnumerable<StorageLocationLookupItem>>> SearchStorageLocations { get; set; } =
        (_, _) => Task.FromResult(Enumerable.Empty<StorageLocationLookupItem>());

    [Parameter]
    public EventCallback ReloadRequested { get; set; }

    private string? StorageLocationHelperText =>
        SelectedWarehouseId is null ? Localizer["Common.SelectWarehouseFirst"] : null;

    private async Task OnWarehouseChanged(Guid? value) => await SelectedWarehouseIdChanged.InvokeAsync(value);

    private async Task OnStatusChanged(string? value) => await SelectedStatusChanged.InvokeAsync(value);

    private async Task OnTransitChanged(bool? value) => await HasTransitLocationChanged.InvokeAsync(value);

    private async Task OnTransferCodeChanged(string? value) => await TransferCodeChanged.InvokeAsync(value);

    private async Task OnCreatedFromChanged(DateTime? value) => await CreatedFromChanged.InvokeAsync(value);

    private async Task OnCreatedToChanged(DateTime? value) => await CreatedToChanged.InvokeAsync(value);

    private async Task OnStockKeepingUnitChanged(StockKeepingUnitLookupItem? value) =>
        await SelectedStockKeepingUnitChanged.InvokeAsync(value);

    private async Task OnSourceStorageLocationChanged(StorageLocationLookupItem? value) =>
        await SelectedSourceStorageLocationChanged.InvokeAsync(value);

    private async Task OnDestinationStorageLocationChanged(StorageLocationLookupItem? value) =>
        await SelectedDestinationStorageLocationChanged.InvokeAsync(value);

    private async Task OnReloadRequested() => await ReloadRequested.InvokeAsync();

    private static string FormatStorageLocation(StorageLocationLookupItem? storageLocation) =>
        storageLocation is null ? string.Empty : $"{storageLocation.Code} - {storageLocation.Name}";

    private static string FormatStockKeepingUnit(StockKeepingUnitLookupItem? stockKeepingUnit) =>
        stockKeepingUnit is null ? string.Empty : $"{stockKeepingUnit.Code} - {stockKeepingUnit.Name}";
}
