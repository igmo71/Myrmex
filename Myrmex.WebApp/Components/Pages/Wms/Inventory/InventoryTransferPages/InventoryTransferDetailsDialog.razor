@using Myrmex.Shared.Wms.Inventory
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Transfer.Code</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Common.Status"]</MudText>
                    <MudText Typo="Typo.body2">@Transfer.Status</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Common.Warehouse"]</MudText>
                    <MudText Typo="Typo.body2">@WarehouseDisplayFormatter.GetName(Transfer.SourceWarehouse.Name, Localizer)</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryTransfer.Transit"]</MudText>
                    <MudText Typo="Typo.body2">@(Transfer.TransitStorageLocation?.Code ?? Localizer["InventoryTransfer.Direct"])</MudText>
                </MudItem>
            </MudGrid>

            <MudTable Items="Transfer.Lines" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@Localizer["Common.Sku"]</MudTh>
                    <MudTh>@Localizer["Common.Source"]</MudTh>
                    <MudTh>@Localizer["Common.Destination"]</MudTh>
                    <MudTh>@Localizer["Sku.BaseUnitOfMeasure"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.Requested"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.Moved"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.Picked"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.Placed"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.InTransit"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.RemainingPick"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.RemainingPlace"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Sku.Code</MudTd>
                    <MudTd>@context.SourceStorageLocation.Code</MudTd>
                    <MudTd>@context.DestinationStorageLocation.Code</MudTd>
                    <MudTd>@FormatBaseUnitOfMeasure(context)</MudTd>
                    <MudTd>@context.RequestedQuantity</MudTd>
                    <MudTd>@context.MovedQuantity</MudTd>
                    <MudTd>@context.PickedQuantity</MudTd>
                    <MudTd>@context.PlacedQuantity</MudTd>
                    <MudTd>@context.InTransitQuantity</MudTd>
                    <MudTd>@context.RemainingToPickQuantity</MudTd>
                    <MudTd>@context.RemainingToPlaceQuantity</MudTd>
                    <MudTd>
                        @if (CanMove(context))
                        {
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => OpenMovementDialogAsync(context, InventoryTransferMovementDialog.MoveAction))">
                                @Localizer["Common.Move"]
                            </MudButton>
                        }
                        @if (CanPick(context))
                        {
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => OpenMovementDialogAsync(context, InventoryTransferMovementDialog.PickAction))">
                                @Localizer["InventoryTransfer.Pick"]
                            </MudButton>
                        }
                        @if (CanPlace(context))
                        {
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => OpenMovementDialogAsync(context, InventoryTransferMovementDialog.PlaceAction))">
                                @Localizer["InventoryTransfer.Place"]
                            </MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.subtitle1">@Localizer["InventoryTransfer.MovementHistory"]</MudText>
            <MudTable Items="Transfer.Movements" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@Localizer["InventoryTransfer.Occurred"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.Meaning"]</MudTh>
                    <MudTh>@Localizer["Common.Sku"]</MudTh>
                    <MudTh>@Localizer["Common.From"]</MudTh>
                    <MudTh>@Localizer["Common.To"]</MudTh>
                    <MudTh>@Localizer["Common.Quantity"]</MudTh>
                    <MudTh>@Localizer["Sku.BaseUnitOfMeasure"]</MudTh>
                    <MudTh>@Localizer["InventoryTransfer.Transaction"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.OccurredAtUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>@context.MovementMeaning</MudTd>
                    <MudTd>@context.Sku.Code</MudTd>
                    <MudTd>@context.FromStorageLocation.Code</MudTd>
                    <MudTd>@context.ToStorageLocation.Code</MudTd>
                    <MudTd>@context.Quantity</MudTd>
                    <MudTd>@FormatBaseUnitOfMeasure(context)</MudTd>
                    <MudTd>@context.InventoryTransactionId</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@Localizer["InventoryTransfer.NoMovements"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">@Localizer["Common.Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public InventoryTransferDetails Transfer { get; set; } = null!;

    [Parameter]
    public EventCallback<InventoryTransferDetails> TransferChanged { get; set; }

    private bool IsCompleted => Transfer.Status == InventoryTransferStatusDetails.Completed;

    private void Close() => MudDialog.Close();

    private bool CanMove(InventoryTransferLineDetails line)
    {
        return Transfer.TransitStorageLocation is null &&
               !IsCompleted &&
               line.MovedQuantity < line.RequestedQuantity;
    }

    private bool CanPick(InventoryTransferLineDetails line)
    {
        return Transfer.TransitStorageLocation is not null &&
               !IsCompleted &&
               line.PickedQuantity < line.RequestedQuantity;
    }

    private bool CanPlace(InventoryTransferLineDetails line)
    {
        return Transfer.TransitStorageLocation is not null &&
               !IsCompleted &&
               line.InTransitQuantity > 0;
    }

    private async Task OpenMovementDialogAsync(
        InventoryTransferLineDetails line,
        string action)
    {
        DialogParameters parameters = new()
        {
            [nameof(InventoryTransferMovementDialog.Transfer)] = Transfer,
            [nameof(InventoryTransferMovementDialog.Line)] = line,
            [nameof(InventoryTransferMovementDialog.Action)] = action
        };

        DialogOptions options = new()
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        IDialogReference dialog = await DialogService.ShowAsync<InventoryTransferMovementDialog>(
            MovementDialogTitle(action),
            parameters,
            options);

        DialogResult? result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is InventoryTransferDetails updatedTransfer)
        {
            Transfer = updatedTransfer;
            await TransferChanged.InvokeAsync(updatedTransfer);
        }
    }

    private string MovementDialogTitle(string action) => action switch
    {
        InventoryTransferMovementDialog.PickAction => Localizer["InventoryTransfer.PickLineTitle"],
        InventoryTransferMovementDialog.PlaceAction => Localizer["InventoryTransfer.PlaceLineTitle"],
        _ => Localizer["InventoryTransfer.MoveLineTitle"]
    };

    private static string FormatBaseUnitOfMeasure(InventoryTransferLineDetails line) =>
        string.IsNullOrWhiteSpace(line.Sku.BaseUom.Symbol)
            ? line.Sku.BaseUom.Code
            : line.Sku.BaseUom.Symbol;

    private static string FormatBaseUnitOfMeasure(InventoryTransferMovementDetails movement) =>
        string.IsNullOrWhiteSpace(movement.Sku.BaseUom.Symbol)
            ? movement.Sku.BaseUom.Code
            : movement.Sku.BaseUom.Symbol;
}
