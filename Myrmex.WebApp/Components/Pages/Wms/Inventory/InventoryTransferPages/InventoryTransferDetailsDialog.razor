@using Myrmex.Shared.Wms.Inventory
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Transfer.Code</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                    <MudText Typo="Typo.body2">@Transfer.Status</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Warehouse</MudText>
                    <MudText Typo="Typo.body2">@Transfer.SourceWarehouse.Code - @Transfer.SourceWarehouse.Name</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Transit</MudText>
                    <MudText Typo="Typo.body2">@(Transfer.TransitStorageLocation?.Code ?? "Direct")</MudText>
                </MudItem>
            </MudGrid>

            <MudTable Items="Transfer.Lines" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>SKU</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Destination</MudTh>
                    <MudTh>Requested</MudTh>
                    <MudTh>Moved</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Sku.Code</MudTd>
                    <MudTd>@context.SourceStorageLocation.Code</MudTd>
                    <MudTd>@context.DestinationStorageLocation.Code</MudTd>
                    <MudTd>@context.RequestedQuantity</MudTd>
                    <MudTd>@context.MovedQuantity</MudTd>
                    <MudTd>
                        @if (CanMove(context))
                        {
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       OnClick="@(() => OpenMoveDialogAsync(context))">
                                Move
                            </MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public InventoryTransferDetails Transfer { get; set; } = null!;

    [Parameter]
    public EventCallback<InventoryTransferDetails> TransferChanged { get; set; }

    private void Close() => MudDialog.Close();

    private bool CanMove(InventoryTransferLineDetails line)
    {
        return Transfer.TransitStorageLocation is null &&
               Transfer.Status != InventoryTransferStatusDetails.Completed &&
               line.MovedQuantity < line.RequestedQuantity;
    }

    private async Task OpenMoveDialogAsync(InventoryTransferLineDetails line)
    {
        DialogParameters parameters = new()
        {
            [nameof(InventoryTransferMovementDialog.Transfer)] = Transfer,
            [nameof(InventoryTransferMovementDialog.Line)] = line
        };

        DialogOptions options = new()
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        IDialogReference dialog = await DialogService.ShowAsync<InventoryTransferMovementDialog>(
            "Move transfer line",
            parameters,
            options);

        DialogResult? result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is InventoryTransferDetails updatedTransfer)
        {
            Transfer = updatedTransfer;
            await TransferChanged.InvokeAsync(updatedTransfer);
        }
    }
}
