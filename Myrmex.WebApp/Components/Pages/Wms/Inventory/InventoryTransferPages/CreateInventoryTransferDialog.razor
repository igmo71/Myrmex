@using System.Globalization
@using Myrmex.Shared.Common
@using Myrmex.Shared.Wms.Catalog
@using Myrmex.Shared.Wms.Inventory
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["InventoryTransfer.CreateTitle"]</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudAutocomplete T="WarehouseLookupItem"
                                 Label="@Localizer["Common.Warehouse"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Required="true"
                                 RequiredError="@Localizer["Common.WarehouseRequired"]"
                                 Clearable="true"
                                 ShowProgressIndicator="true"
                                 MinCharacters="0"
                                 DebounceInterval="300"
                                 MaxItems="20"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 Value="_selectedWarehouse"
                                 ValueChanged="OnWarehouseChanged"
                                 SearchFunc="SearchWarehousesAsync"
                                 ToStringFunc="FormatWarehouse">
                    <ItemTemplate>
                        <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <MudText>@Localizer["Warehouse.NoneFound"]</MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>

                <MudAutocomplete T="StorageLocationLookupItem"
                                 Label="@Localizer["InventoryTransfer.InternalTransitLocation"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Clearable="true"
                                 ShowProgressIndicator="true"
                                 MinCharacters="0"
                                 DebounceInterval="300"
                                 MaxItems="20"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 Disabled="_warehouseId is null"
                                 Value="_transitStorageLocation"
                                 ValueChanged="OnTransitStorageLocationChanged"
                                 SearchFunc="SearchInternalTransitLocationsAsync"
                                 ToStringFunc="FormatStorageLocation"
                                 HelperText="&#160;">
                    <ItemTemplate>
                        <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <MudText>@Localizer["StorageLocation.NoneFound"]</MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>

                <MudStack Spacing="2">
                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle2">@Localizer["InventoryTransfer.Lines"]</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="AddLine" />
                    </MudStack>

                    @foreach (TransferLineModel line in _lines)
                    {
                        <MudPaper Class="pa-3" Outlined="true">
                            <MudStack Spacing="2">
                                <MudStack Row="true"
                                          AlignItems="AlignItems.Center"
                                          Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">@Localizer["InventoryTransfer.LineNumber", _lines.IndexOf(line) + 1]</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   Disabled="_lines.Count == 1"
                                                   OnClick="@(() => RemoveLine(line))" />
                                </MudStack>

                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudAutocomplete T="StockKeepingUnitLookupItem"
                                                         Label="@Localizer["Common.Sku"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Required="true"
                                                         RequiredError="@Localizer["Common.SkuRequired"]"
                                                         Clearable="true"
                                                         ShowProgressIndicator="true"
                                                         MinCharacters="0"
                                                         DebounceInterval="300"
                                                         MaxItems="20"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceText="false"
                                                         CoerceValue="false"
                                                         Value="line.StockKeepingUnit"
                                                         ValueChanged="@((StockKeepingUnitLookupItem? value) => OnStockKeepingUnitChanged(line, value))"
                                                         SearchFunc="SearchStockKeepingUnitsAsync"
                                                         ToStringFunc="FormatStockKeepingUnit">
                                            <ItemTemplate>
                                                <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                                            </ItemTemplate>
                                        </MudAutocomplete>
                                    </MudItem>

                                    <MudItem xs="12" md="6">
                                        <MudNumericField T="decimal"
                                                         Label="@Localizer["InventoryTransfer.RequestedQuantity"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Validation="@((Func<decimal, string?>)ValidatePositiveQuantity)"
                                                         Required="true"
                                                         RequiredError="@Localizer["InventoryTransfer.RequestedQuantityRequired"]"
                                                         Culture="@QuantityCulture"
                                                         Format="0.###"
                                                         InputMode="@(InputMode.@decimal)"
                                                         @bind-Value="line.RequestedQuantity" />
                                    </MudItem>

                                    <MudItem xs="12" md="6">
                                        <MudAutocomplete T="StorageLocationLookupItem"
                                                         Label="@Localizer["InventoryTransfer.SourceLocation"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Required="true"
                                                         RequiredError="@Localizer["InventoryTransfer.SourceLocationRequired"]"
                                                         Clearable="true"
                                                         ShowProgressIndicator="true"
                                                         MinCharacters="0"
                                                         DebounceInterval="300"
                                                         MaxItems="20"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceText="false"
                                                         CoerceValue="false"
                                                         Disabled="_warehouseId is null"
                                                         Value="line.SourceStorageLocation"
                                                         ValueChanged="@((StorageLocationLookupItem? value) => OnSourceStorageLocationChanged(line, value))"
                                                         SearchFunc="SearchRegularStorageLocationsAsync"
                                                         ToStringFunc="FormatStorageLocation">
                                            <ItemTemplate>
                                                <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                                            </ItemTemplate>
                                        </MudAutocomplete>
                                    </MudItem>

                                    <MudItem xs="12" md="6">
                                        <MudAutocomplete T="StorageLocationLookupItem"
                                                         Label="@Localizer["InventoryTransfer.DestinationLocation"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Required="true"
                                                         RequiredError="@Localizer["InventoryTransfer.DestinationLocationRequired"]"
                                                         Clearable="true"
                                                         ShowProgressIndicator="true"
                                                         MinCharacters="0"
                                                         DebounceInterval="300"
                                                         MaxItems="20"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceText="false"
                                                         CoerceValue="false"
                                                         Disabled="_warehouseId is null"
                                                         Value="line.DestinationStorageLocation"
                                                         ValueChanged="@((StorageLocationLookupItem? value) => OnDestinationStorageLocationChanged(line, value))"
                                                         SearchFunc="SearchRegularStorageLocationsAsync"
                                                         ToStringFunc="FormatStorageLocation">
                                            <ItemTemplate>
                                                <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                                            </ItemTemplate>
                                        </MudAutocomplete>
                                    </MudItem>
                                </MudGrid>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                        @_errorMessage
                    </MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="_isSaving">
            @Localizer["Common.Cancel"]
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="me-2" />
            }
            @Localizer["Common.Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int AutocompleteTake = 20;
    private const string InternalTransitStorageLocationTypeCode = "INTERNAL_TRANSIT";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private WmsInventoryApiClient WmsInventoryApiClient { get; set; } = null!;

    [Inject]
    private WmsCatalogApiClient WmsCatalogApiClient { get; set; } = null!;

    [Inject]
    private WmsTopologyApiClient WmsTopologyApiClient { get; set; } = null!;

    private MudForm? _form;
    private readonly List<TransferLineModel> _lines = [new()];
    private readonly Dictionary<string, IReadOnlyList<StorageLocationLookupItem>> _storageLocationCache = [];
    private static CultureInfo QuantityCulture => CultureInfo.CurrentCulture;

    private WarehouseLookupItem? _selectedWarehouse;
    private Guid? _warehouseId;
    private StorageLocationLookupItem? _transitStorageLocation;
    private bool _isSaving;
    private string? _errorMessage;
    private int _storageLocationSearchVersion;

    private async Task<IEnumerable<WarehouseLookupItem>> SearchWarehousesAsync(
        string value,
        CancellationToken cancellationToken)
    {
        try
        {
            return await WmsTopologyApiClient.LookupWarehousesAsync(
                new LookupWarehousesRequest
                {
                    SearchText = value,
                    Take = AutocompleteTake,
                    SelectableOnly = true
                },
                cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            return [];
        }
    }

    private Task OnWarehouseChanged(WarehouseLookupItem? value)
    {
        _selectedWarehouse = value;
        _warehouseId = value?.Id;
        _transitStorageLocation = null;
        _storageLocationCache.Clear();
        _storageLocationSearchVersion++;

        foreach (TransferLineModel line in _lines)
        {
            line.SourceStorageLocation = null;
            line.DestinationStorageLocation = null;
        }

        return Task.CompletedTask;
    }

    private Task OnTransitStorageLocationChanged(StorageLocationLookupItem? value)
    {
        _transitStorageLocation = CoerceWarehouseLocation(value);
        return Task.CompletedTask;
    }

    private Task OnStockKeepingUnitChanged(TransferLineModel line, StockKeepingUnitLookupItem? value)
    {
        line.StockKeepingUnit = value;
        return Task.CompletedTask;
    }

    private Task OnSourceStorageLocationChanged(TransferLineModel line, StorageLocationLookupItem? value)
    {
        line.SourceStorageLocation = CoerceWarehouseLocation(value);
        return Task.CompletedTask;
    }

    private Task OnDestinationStorageLocationChanged(TransferLineModel line, StorageLocationLookupItem? value)
    {
        line.DestinationStorageLocation = CoerceWarehouseLocation(value);
        return Task.CompletedTask;
    }

    private void AddLine()
    {
        _lines.Add(new TransferLineModel());
    }

    private void RemoveLine(TransferLineModel line)
    {
        if (_lines.Count == 1)
        {
            return;
        }

        _lines.Remove(line);
    }

    private async Task<IEnumerable<StockKeepingUnitLookupItem>> SearchStockKeepingUnitsAsync(
        string value,
        CancellationToken cancellationToken)
    {
        try
        {
            IReadOnlyList<StockKeepingUnitLookupItem> items = await WmsCatalogApiClient
                .LookupStockKeepingUnitsAsync(
                    new LookupStockKeepingUnitsRequest
                    {
                        SearchText = value,
                        Take = AutocompleteTake,
                        SelectableOnly = true
                    },
                    cancellationToken);

            return items;
        }
        catch (Exception exception)
            when (exception is OperationCanceledException && cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            return [];
        }
    }

    private Task<IEnumerable<StorageLocationLookupItem>> SearchInternalTransitLocationsAsync(
        string value,
        CancellationToken cancellationToken)
    {
        return SearchStorageLocationsAsync(
            value,
            storageLocationTypeCode: InternalTransitStorageLocationTypeCode,
            excludeTransitTypes: false,
            cancellationToken);
    }

    private Task<IEnumerable<StorageLocationLookupItem>> SearchRegularStorageLocationsAsync(
        string value,
        CancellationToken cancellationToken)
    {
        return SearchStorageLocationsAsync(
            value,
            storageLocationTypeCode: null,
            excludeTransitTypes: true,
            cancellationToken);
    }

    private async Task<IEnumerable<StorageLocationLookupItem>> SearchStorageLocationsAsync(
        string value,
        string? storageLocationTypeCode,
        bool excludeTransitTypes,
        CancellationToken cancellationToken)
    {
        if (_warehouseId is not Guid warehouseId)
        {
            return [];
        }

        int searchVersion = _storageLocationSearchVersion;
        string cacheKey = $"{warehouseId:N}:{storageLocationTypeCode}:{excludeTransitTypes}:{value}";

        if (_storageLocationCache.TryGetValue(cacheKey, out IReadOnlyList<StorageLocationLookupItem>? cachedItems))
        {
            return cachedItems;
        }

        try
        {
            IReadOnlyList<StorageLocationLookupItem> items = await WmsTopologyApiClient
                .LookupStorageLocationsAsync(
                    warehouseId,
                    new LookupStorageLocationsRequest
                    {
                        SearchText = value,
                        Take = AutocompleteTake,
                        SelectableOnly = true,
                        StorageLocationTypeCode = storageLocationTypeCode,
                        ExcludeTransitTypes = excludeTransitTypes
                    },
                    cancellationToken);

            if (searchVersion != _storageLocationSearchVersion ||
                _warehouseId != warehouseId)
            {
                return [];
            }

            _storageLocationCache[cacheKey] = items;
            return items;
        }
        catch (Exception exception)
            when (exception is OperationCanceledException && cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            return [];
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        string? clientError = ValidateClientState();

        if (clientError is not null)
        {
            _errorMessage = clientError;
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            CreateInventoryTransferRequest request = new(
                _warehouseId,
                _warehouseId,
                _transitStorageLocation?.Id,
                _lines.Select(line => new CreateInventoryTransferLineRequest(
                        line.StockKeepingUnit?.Id,
                        line.SourceStorageLocation?.Id,
                        line.DestinationStorageLocation?.Id,
                        line.RequestedQuantity))
                    .ToArray());

            ApiResult<InventoryTransferDetails> result = await WmsInventoryApiClient
                .TryCreateInventoryTransferAsync(request);

            if (result.IsFailure)
            {
                _errorMessage = result.Error?.Message ?? Localizer["InventoryTransfer.CreateError"];
                return;
            }

            if (result.Value is null)
            {
                _errorMessage = Localizer["InventoryTransfer.MissingResult"];
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string? ValidateClientState()
    {
        if (_warehouseId is null)
        {
            return Localizer["Common.WarehouseRequired"];
        }

        if (_lines.Count == 0)
        {
            return Localizer["InventoryTransfer.LineRequired"];
        }

        for (int index = 0; index < _lines.Count; index++)
        {
            TransferLineModel line = _lines[index];

            if (line.StockKeepingUnit is null)
            {
                return Localizer["InventoryTransfer.LineSkuRequired", index + 1];
            }

            if (line.SourceStorageLocation is null)
            {
                return Localizer["InventoryTransfer.LineSourceRequired", index + 1];
            }

            if (line.DestinationStorageLocation is null)
            {
                return Localizer["InventoryTransfer.LineDestinationRequired", index + 1];
            }

            if (line.SourceStorageLocation.Id == line.DestinationStorageLocation.Id)
            {
                return Localizer["InventoryTransfer.LineLocationsMustDiffer", index + 1];
            }

            if (line.RequestedQuantity <= 0)
            {
                return Localizer["InventoryTransfer.LineQuantityPositive", index + 1];
            }
        }

        return null;
    }

    private StorageLocationLookupItem? CoerceWarehouseLocation(StorageLocationLookupItem? value)
    {
        if (value is not null &&
            (_warehouseId is null || value.WarehouseId != _warehouseId.Value))
        {
            return null;
        }

        return value;
    }

    private void Cancel() => MudDialog.Cancel();

    private static string FormatStorageLocation(StorageLocationLookupItem? storageLocation) =>
        storageLocation is null ? string.Empty : $"{storageLocation.Code} - {storageLocation.Name}";

    private static string FormatWarehouse(WarehouseLookupItem? warehouse) =>
        warehouse is null ? string.Empty : $"{warehouse.Code} - {warehouse.Name}";

    private static string FormatStockKeepingUnit(StockKeepingUnitLookupItem? stockKeepingUnit) =>
        stockKeepingUnit is null ? string.Empty : $"{stockKeepingUnit.Code} - {stockKeepingUnit.Name}";

    private sealed class TransferLineModel
    {
        public StockKeepingUnitLookupItem? StockKeepingUnit { get; set; }

        public StorageLocationLookupItem? SourceStorageLocation { get; set; }

        public StorageLocationLookupItem? DestinationStorageLocation { get; set; }

        public decimal RequestedQuantity { get; set; } = 1;
    }

    protected string? ValidatePositiveQuantity(decimal quantity) =>
        quantity > 0 ? null : Localizer["Common.QuantityMustBePositive"].Value;
}
