@using Myrmex.Shared.Wms.Inventory

<MudDataGrid T="InventoryBalanceDetails"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Single"
             Filterable="false">
    <Columns>
        <TemplateColumn Title="SKU"
                        Tag="@InventoryBalanceSortBy.SkuCode"
                        SortBy="@(balance => balance.Sku.Code)"
                        Sortable="true">
            <CellTemplate>
                <MudText Typo="Typo.body2">
                    @context.Item.Sku.Code
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @context.Item.Sku.Name
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Warehouse"
                        Tag="@InventoryBalanceSortBy.WarehouseCode"
                        SortBy="@(balance => balance.StorageLocation.Warehouse.Code)"
                        Sortable="true">
            <CellTemplate>
                <MudText Typo="Typo.body2">
                    @context.Item.StorageLocation.Warehouse.Code
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @context.Item.StorageLocation.Warehouse.Name
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Storage location"
                        Tag="@InventoryBalanceSortBy.StorageLocationCode"
                        SortBy="@(balance => balance.StorageLocation.Code)"
                        Sortable="true">
            <CellTemplate>
                <MudText Typo="Typo.body2">
                    @context.Item.StorageLocation.Code
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @context.Item.StorageLocation.Name
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Quantity"
                        Tag="@InventoryBalanceSortBy.Quantity"
                        SortBy="@(balance => balance.Quantity)"
                        Sortable="true">
            <CellTemplate>
                @context.Item.Quantity @GetBaseUnitOfMeasureDisplay(context.Item)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Actions"
                        Sortable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => UpdateQuantityRequested.InvokeAsync(context.Item))">
                        Update quantity
                    </MudMenuItem>
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <NoRecordsContent>
        <MudText>No inventory balances match the current filters.</MudText>
    </NoRecordsContent>

    <PagerContent>
        <MudDataGridPager T="InventoryBalanceDetails" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public Func<InventoryBalanceGridRequest, CancellationToken, Task<GridData<InventoryBalanceDetails>>> LoadData { get; set; } = default!;

    [Parameter]
    public EventCallback<InventoryBalanceDetails> UpdateQuantityRequested { get; set; }

    private MudDataGrid<InventoryBalanceDetails>? _dataGrid;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private Task<GridData<InventoryBalanceDetails>> LoadServerDataAsync(
        GridState<InventoryBalanceDetails> state,
        CancellationToken cancellationToken)
    {
        SortDefinition<InventoryBalanceDetails>? sortDefinition =
            state.SortDefinitions.FirstOrDefault();

        InventoryBalanceGridRequest request = new(
            Skip: state.Page * state.PageSize,
            Take: state.PageSize,
            SortBy: ResolveSortBy(sortDefinition),
            SortDescending: sortDefinition?.Descending ?? false);

        return LoadData(request, cancellationToken);
    }

    private string ResolveSortBy(SortDefinition<InventoryBalanceDetails>? sortDefinition)
    {
        if (sortDefinition is null)
        {
            return InventoryBalanceSortBy.SkuCode;
        }

        Column<InventoryBalanceDetails>? column =
            _dataGrid?.GetColumnByPropertyName(sortDefinition.SortBy);

        return column?.Tag as string
            ?? InventoryBalanceSortBy.SkuCode;
    }

    public async Task ReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        await _dataGrid.ReloadServerData();
    }

    public async Task ResetAndReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        if (_dataGrid.CurrentPage == 0)
        {
            await _dataGrid.ReloadServerData();
            return;
        }

        _dataGrid.NavigateTo(Page.First);
    }

    private static string GetBaseUnitOfMeasureDisplay(InventoryBalanceDetails inventoryBalance)
    {
        return string.IsNullOrWhiteSpace(inventoryBalance.Sku.BaseUom.Symbol)
            ? inventoryBalance.Sku.BaseUom.Code
            : inventoryBalance.Sku.BaseUom.Symbol;
    }
}
