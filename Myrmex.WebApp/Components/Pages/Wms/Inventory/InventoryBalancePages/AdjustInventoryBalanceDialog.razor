@using System.Globalization
@using Myrmex.Shared.Wms.Inventory

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Adjust inventory balance</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              Label="SKU"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Value="@StockKeepingUnitDisplay"
                              Disabled="true" />

                <MudTextField T="string"
                              Label="Warehouse"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Value="@WarehouseDisplay"
                              Disabled="true" />

                <MudTextField T="string"
                              Label="Storage location"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Value="@StorageLocationDisplay"
                              Disabled="true" />

                <MudTextField T="string"
                              Label="Base UoM"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Value="@BaseUnitOfMeasureDisplay"
                              Disabled="true" />

                <MudNumericField T="decimal"
                                 Label="Counted quantity"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Required="true"
                                 RequiredError="Counted quantity is required."
                                 Culture="@QuantityCulture"
                                 Format="0.####"
                                 InputMode="@(InputMode.@decimal)"
                                 @bind-Value="_countedQuantity" />

                <MudTextField T="string"
                              Label="Reason"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="Reason is required."
                              MaxLength="500"
                              Lines="3"
                              @bind-Value="_reason" />

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                        @_errorMessage
                    </MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="_isSaving">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="me-2" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public InventoryBalanceDetails InventoryBalance { get; set; } = null!;

    [Inject]
    private WmsInventoryApiClient WmsInventoryApiClient { get; set; } = null!;

    private MudForm? _form;
    private decimal _countedQuantity;
    private string? _reason;
    private bool _isSaving;
    private string? _errorMessage;

    private static readonly CultureInfo QuantityCulture = CultureInfo.GetCultureInfo("ru-RU");

    private string StockKeepingUnitDisplay =>
        $"{InventoryBalance.Sku.Code} - {InventoryBalance.Sku.Name}";

    private string WarehouseDisplay =>
        $"{InventoryBalance.StorageLocation.Warehouse.Code} - {InventoryBalance.StorageLocation.Warehouse.Name}";

    private string StorageLocationDisplay =>
        $"{InventoryBalance.StorageLocation.Code} - {InventoryBalance.StorageLocation.Name}";

    private string BaseUnitOfMeasureDisplay =>
        string.IsNullOrWhiteSpace(InventoryBalance.Sku.BaseUom.Symbol)
            ? InventoryBalance.Sku.BaseUom.Code
            : $"{InventoryBalance.Sku.BaseUom.Code} ({InventoryBalance.Sku.BaseUom.Symbol})";

    protected override void OnInitialized()
    {
        _countedQuantity = InventoryBalance.Quantity;
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        if (_countedQuantity < 0)
        {
            _errorMessage = "Counted quantity must be greater than or equal to zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_reason))
        {
            _errorMessage = "Reason is required.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            AdjustInventoryBalanceRequest request = new(
                InventoryBalance.Sku.Id,
                InventoryBalance.StorageLocation.Id,
                _countedQuantity,
                _reason,
                InventoryBalance.BalanceVersion);

            ApiResult<InventoryBalanceDetails> result = await WmsInventoryApiClient
                .TryAdjustInventoryBalanceAsync(request);

            if (result.IsFailure)
            {
                _errorMessage = result.Error?.Message ?? "Inventory balance adjustment failed.";
                return;
            }

            if (result.Value is null)
            {
                _errorMessage = "The operation completed without returning inventory balance details.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
