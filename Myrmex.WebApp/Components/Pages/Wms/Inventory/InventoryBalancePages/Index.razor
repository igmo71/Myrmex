@page "/wms/inventory/balances"

<PageTitle>WMS Inventory Balances</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
    <MudStack Spacing="3">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">Inventory Balances</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Current SKU quantities by warehouse and storage location.
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="CreateInventoryBalanceAsync"
                           Disabled="_isLoadingWarehouses">
                    Create
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync">
                    Refresh
                </MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                @_errorMessage
            </MudAlert>
        }

        <InventoryBalanceFilters Warehouses="@_warehouses"
                                 SelectedWarehouseId="@_selectedWarehouseId"
                                 SelectedWarehouseIdChanged="OnWarehouseChanged"
                                 SelectedStorageLocation="@_selectedStorageLocation"
                                 SelectedStorageLocationChanged="OnStorageLocationChanged"
                                 SelectedStockKeepingUnit="@_selectedStockKeepingUnit"
                                 SelectedStockKeepingUnitChanged="OnStockKeepingUnitChanged"
                                 IsLoadingWarehouses="@_isLoadingWarehouses"
                                 SearchStockKeepingUnits="SearchStockKeepingUnitsAsync"
                                 SearchStorageLocations="SearchStorageLocationsAsync" />

        <InventoryBalanceGrid @ref="_inventoryBalanceGrid"
                              LoadData="LoadInventoryBalancesAsync"
                              UpdateQuantityRequested="UpdateInventoryBalanceQuantityAsync" />
    </MudStack>
</MudContainer>
