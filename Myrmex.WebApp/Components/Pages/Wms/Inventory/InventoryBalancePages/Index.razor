@page "/wms/inventory/balances"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["InventoryBalance.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
    <MudStack Spacing="3">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">@Localizer["InventoryBalance.Heading"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["InventoryBalance.Description"]
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenInitialCountAsync"
                           Disabled="_isLoadingWarehouses">
                    @Localizer["InventoryBalance.InitialCount"]
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync">
                    @Localizer["Common.Refresh"]
                </MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                @_errorMessage
            </MudAlert>
        }

        <InventoryBalanceFilters Warehouses="@_warehouses"
                                 SelectedWarehouseId="@_selectedWarehouseId"
                                 SelectedWarehouseIdChanged="OnWarehouseChanged"
                                 SelectedStorageLocation="@_selectedStorageLocation"
                                 SelectedStorageLocationChanged="OnStorageLocationChanged"
                                 SelectedStockKeepingUnit="@_selectedStockKeepingUnit"
                                 SelectedStockKeepingUnitChanged="OnStockKeepingUnitChanged"
                                 IsLoadingWarehouses="@_isLoadingWarehouses"
                                 SearchStockKeepingUnits="SearchStockKeepingUnitsAsync"
                                 SearchStorageLocations="SearchStorageLocationsAsync" />

        <InventoryBalanceGrid @ref="_inventoryBalanceGrid"
                              LoadData="LoadInventoryBalancesAsync"
                              AdjustRequested="AdjustInventoryBalanceAsync"
                              MoveRequested="MoveInventoryBalanceAsync"
                              HistoryRequested="OpenInventoryLedgerHistory" />
    </MudStack>
</MudContainer>
