@using Myrmex.Shared.Wms.Catalog
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
        <MudAutocomplete T="WarehouseLookupItem"
                         Label="@Localizer["Common.Warehouse"]"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Clearable="true"
                         ShowProgressIndicator="true"
                         MinCharacters="0"
                         DebounceInterval="300"
                         MaxItems="20"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         CoerceValue="false"
                         Value="SelectedWarehouse"
                         ValueChanged="OnWarehouseChanged"
                         SearchFunc="SearchWarehouses"
                         ToStringFunc="FormatWarehouse"
                         HelperText="&#160;"
                         Class="min-width-300">
            <ItemTemplate>
                <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText>@Localizer["Warehouse.NoneFound"]</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>

        <MudAutocomplete T="StorageLocationLookupItem"
                         Label="@Localizer["Common.StorageLocation"]"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Clearable="true"
                         ShowProgressIndicator="true"
                         MinCharacters="0"
                         DebounceInterval="300"
                         MaxItems="20"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         CoerceValue="false"
                         Value="SelectedStorageLocation"
                         ValueChanged="OnStorageLocationChanged"
                         SearchFunc="SearchStorageLocations"
                         ToStringFunc="FormatStorageLocation"
                         Disabled="SelectedWarehouse is null"
                         HelperText="@StorageLocationHelperText"
                         Class="min-width-300">
            <ItemTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                    @if (!context.IsActive)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@Localizer["Common.Inactive"]</MudText>
                    }
                </MudStack>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText>@Localizer["StorageLocation.NoneFound"]</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>

        <MudAutocomplete T="StockKeepingUnitLookupItem"
                         Label="@Localizer["Common.Sku"]"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Clearable="true"
                         ShowProgressIndicator="true"
                         MinCharacters="0"
                         DebounceInterval="300"
                         MaxItems="20"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         CoerceValue="false"
                         Value="SelectedStockKeepingUnit"
                         ValueChanged="OnStockKeepingUnitChanged"
                         SearchFunc="SearchStockKeepingUnits"
                         ToStringFunc="FormatStockKeepingUnit"
                         HelperText="&#160;"
                         Class="min-width-300">
            <ItemTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                    @if (!context.IsActive || !context.IsBaseUnitOfMeasureActive)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@Localizer["Common.Inactive"]</MudText>
                    }
                </MudStack>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText>@Localizer["Sku.NoneFound"]</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public WarehouseLookupItem? SelectedWarehouse { get; set; }

    [Parameter]
    public EventCallback<WarehouseLookupItem?> SelectedWarehouseChanged { get; set; }

    [Parameter]
    public Func<string, CancellationToken, Task<IEnumerable<WarehouseLookupItem>>> SearchWarehouses { get; set; } =
        (_, _) => Task.FromResult(Enumerable.Empty<WarehouseLookupItem>());

    [Parameter]
    public StorageLocationLookupItem? SelectedStorageLocation { get; set; }

    [Parameter]
    public EventCallback<StorageLocationLookupItem?> SelectedStorageLocationChanged { get; set; }

    [Parameter]
    public StockKeepingUnitLookupItem? SelectedStockKeepingUnit { get; set; }

    [Parameter]
    public EventCallback<StockKeepingUnitLookupItem?> SelectedStockKeepingUnitChanged { get; set; }

    [Parameter]
    public Func<string, CancellationToken, Task<IEnumerable<StockKeepingUnitLookupItem>>> SearchStockKeepingUnits { get; set; } =
        (_, _) => Task.FromResult(Enumerable.Empty<StockKeepingUnitLookupItem>());

    [Parameter]
    public Func<string, CancellationToken, Task<IEnumerable<StorageLocationLookupItem>>> SearchStorageLocations { get; set; } =
        (_, _) => Task.FromResult(Enumerable.Empty<StorageLocationLookupItem>());

    private string? StorageLocationHelperText =>
        SelectedWarehouse is null ? Localizer["Common.SelectWarehouseFirst"].Value : null;

    private async Task OnWarehouseChanged(WarehouseLookupItem? value)
    {
        await SelectedWarehouseChanged.InvokeAsync(value);
    }

    private async Task OnStorageLocationChanged(StorageLocationLookupItem? value)
    {
        await SelectedStorageLocationChanged.InvokeAsync(value);
    }

    private async Task OnStockKeepingUnitChanged(StockKeepingUnitLookupItem? value)
    {
        await SelectedStockKeepingUnitChanged.InvokeAsync(value);
    }

    private static string FormatStorageLocation(StorageLocationLookupItem? storageLocation) =>
        storageLocation is null ? string.Empty : $"{storageLocation.Code} - {storageLocation.Name}";

    private static string FormatWarehouse(WarehouseLookupItem? warehouse) =>
        warehouse is null ? string.Empty : $"{warehouse.Code} - {warehouse.Name}";

    private static string FormatStockKeepingUnit(StockKeepingUnitLookupItem? stockKeepingUnit) =>
        stockKeepingUnit is null ? string.Empty : $"{stockKeepingUnit.Code} - {stockKeepingUnit.Name}";
}
