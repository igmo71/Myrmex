@using System.Globalization
@using Myrmex.Shared.Common
@using Myrmex.Shared.Wms.Catalog
@using Myrmex.Shared.Wms.Inventory
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["InventoryBalance.InitialCount"]</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudAutocomplete T="StockKeepingUnitLookupItem"
                                 Label="@Localizer["Common.Sku"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Required="true"
                                 RequiredError="@Localizer["Common.SkuRequired"]"
                                 Clearable="true"
                                 ShowProgressIndicator="true"
                                 MinCharacters="0"
                                 DebounceInterval="300"
                                 MaxItems="20"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 Value="_selectedStockKeepingUnit"
                                 ValueChanged="OnStockKeepingUnitChanged"
                                 SearchFunc="SearchStockKeepingUnitsAsync"
                                 ToStringFunc="FormatStockKeepingUnit">
                    <ItemTemplate>
                        <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <MudText>@Localizer["Sku.NoneFound"]</MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>

                <MudTextField T="string"
                              Label="@Localizer["Sku.BaseUnitOfMeasure"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Value="@SelectedBaseUnitOfMeasureDisplay"
                              Disabled="true" />

                <MudSelect T="Guid?"
                           Label="@Localizer["Common.Warehouse"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Required="true"
                           RequiredError="@Localizer["Common.WarehouseRequired"]"
                           Disabled="_isLoadingWarehouses"
                           Value="_model.WarehouseId"
                           ValueChanged="OnWarehouseChanged">
                    @foreach (WarehouseDetails warehouse in _warehouses)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)warehouse.Id)">
                            @WarehouseDisplayFormatter.GetName(warehouse.Name, Localizer)
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudAutocomplete T="StorageLocationLookupItem"
                                 Label="@Localizer["Common.StorageLocation"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Required="true"
                                 RequiredError="@Localizer["Common.StorageLocationRequired"]"
                                 Clearable="true"
                                 ShowProgressIndicator="true"
                                 MinCharacters="0"
                                 DebounceInterval="300"
                                 MaxItems="20"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 Disabled="_model.WarehouseId is null"
                                 HelperText="@StorageLocationHelperText"
                                 Value="_selectedStorageLocation"
                                 ValueChanged="OnStorageLocationChanged"
                                 SearchFunc="SearchStorageLocationsAsync"
                                 ToStringFunc="FormatStorageLocation">
                    <ItemTemplate>
                        <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <MudText>@Localizer["StorageLocation.NoneFound"]</MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>

                <MudNumericField T="decimal"
                                 Label="@Localizer["InventoryBalance.CountedQuantity"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Required="true"
                                 RequiredError="@Localizer["InventoryBalance.CountedQuantityRequired"]"
                                 Culture="@QuantityCulture"
                                 Format="0.####"
                                 InputMode="@(InputMode.@decimal)"
                                 @bind-Value="_model.CountedQuantity" />

                <MudTextField T="string"
                              Label="@Localizer["Common.Reason"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="@Localizer["Common.ReasonRequired"]"
                              MaxLength="500"
                              Lines="3"
                              @bind-Value="_model.Reason" />

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                        @_errorMessage
                    </MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="_isSaving">
            @Localizer["Common.Cancel"]
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="_isSaving || _isLoadingWarehouses || _hasConcurrencyConflict">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="me-2" />
            }
            @Localizer["Common.Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string ConcurrencyConflictCode = "InventoryBalance.ConcurrencyConflict";
    private const int LookupTake = 100;
    private const int AutocompleteTake = 20;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private WmsInventoryApiClient WmsInventoryApiClient { get; set; } = null!;

    [Inject]
    private WmsCatalogApiClient WmsCatalogApiClient { get; set; } = null!;

    [Inject]
    private WmsTopologyApiClient WmsTopologyApiClient { get; set; } = null!;

    private MudForm? _form;
    private readonly InitialCountInventoryBalanceModel _model = new();
    private List<WarehouseDetails> _warehouses = [];
    private StockKeepingUnitLookupItem? _selectedStockKeepingUnit;
    private StorageLocationLookupItem? _selectedStorageLocation;
    private static CultureInfo QuantityCulture => CultureInfo.CurrentCulture;

    private bool _isLoadingWarehouses;
    private bool _isSaving;
    private bool _hasConcurrencyConflict;
    private string? _errorMessage;
    private int _storageLocationSearchVersion;

    private string? StorageLocationHelperText
    {
        get
        {
            if (_model.WarehouseId is not null)
            {
                return null;
            }

            return Localizer["Common.SelectWarehouseFirst"].Value;
        }
    }

    private string SelectedBaseUnitOfMeasureDisplay
    {
        get
        {
            if (_selectedStockKeepingUnit is null)
            {
                return Localizer["InventoryBalance.SelectSkuForBaseUnit"].Value;
            }

            return string.IsNullOrWhiteSpace(_selectedStockKeepingUnit.BaseUnitOfMeasureSymbol)
                ? _selectedStockKeepingUnit.BaseUnitOfMeasureCode
                : $"{_selectedStockKeepingUnit.BaseUnitOfMeasureCode} ({_selectedStockKeepingUnit.BaseUnitOfMeasureSymbol})";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehousesAsync();
    }

    private async Task OnStockKeepingUnitChanged(StockKeepingUnitLookupItem? value)
    {
        _selectedStockKeepingUnit = value;
        _model.StockKeepingUnitId = value?.Id;
        await Task.CompletedTask;
    }

    private async Task OnWarehouseChanged(Guid? value)
    {
        _model.WarehouseId = value;
        _model.StorageLocationId = null;
        _selectedStorageLocation = null;
        _storageLocationSearchVersion++;
        await Task.CompletedTask;
    }

    private async Task OnStorageLocationChanged(StorageLocationLookupItem? value)
    {
        if (value is not null &&
            (_model.WarehouseId is null ||
             value.WarehouseId != _model.WarehouseId.Value))
        {
            value = null;
        }

        _selectedStorageLocation = value;
        _model.StorageLocationId = value?.Id;
        await Task.CompletedTask;
    }

    private async Task LoadWarehousesAsync()
    {
        _isLoadingWarehouses = true;
        _errorMessage = null;

        try
        {
            ListWarehousesRequest request = new()
            {
                Skip = 0,
                Take = LookupTake,
                SortBy = WarehouseSortBy.Name,
                SortDescending = false,
                IncludeInactive = false
            };

            ListResult<WarehouseDetails> result = await WmsTopologyApiClient
                .ListWarehousesAsync(request);

            _warehouses = result.Items.ToList();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            _warehouses = [];
        }
        finally
        {
            _isLoadingWarehouses = false;
        }
    }

    private async Task<IEnumerable<StockKeepingUnitLookupItem>> SearchStockKeepingUnitsAsync(
        string value,
        CancellationToken cancellationToken)
    {
        try
        {
            IReadOnlyList<StockKeepingUnitLookupItem> items = await WmsCatalogApiClient
                .LookupStockKeepingUnitsAsync(
                    new LookupStockKeepingUnitsRequest
                    {
                        SearchText = value,
                        Take = AutocompleteTake,
                        SelectableOnly = true
                    },
                    cancellationToken);

            return items;
        }
        catch (Exception exception)
            when (exception is OperationCanceledException && cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            return [];
        }
    }

    private async Task<IEnumerable<StorageLocationLookupItem>> SearchStorageLocationsAsync(
        string value,
        CancellationToken cancellationToken)
    {
        if (_model.WarehouseId is not Guid warehouseId)
        {
            return [];
        }

        int searchVersion = _storageLocationSearchVersion;

        try
        {
            IReadOnlyList<StorageLocationLookupItem> items = await WmsTopologyApiClient
                .LookupStorageLocationsAsync(
                    warehouseId,
                    new LookupStorageLocationsRequest
                    {
                        SearchText = value,
                        Take = AutocompleteTake,
                        SelectableOnly = true
                    },
                    cancellationToken);

            return searchVersion == _storageLocationSearchVersion &&
                   _model.WarehouseId == warehouseId
                ? items
                : [];
        }
        catch (Exception exception)
            when (exception is OperationCanceledException && cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            return [];
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        if (_model.StockKeepingUnitId is null)
        {
            _errorMessage = Localizer["Common.SkuRequired"].Value;
            return;
        }

        if (_model.WarehouseId is null)
        {
            _errorMessage = Localizer["Common.WarehouseRequired"].Value;
            return;
        }

        if (_model.StorageLocationId is null)
        {
            _errorMessage = Localizer["Common.StorageLocationRequired"].Value;
            return;
        }

        if (_model.CountedQuantity < 0)
        {
            _errorMessage = Localizer["InventoryBalance.CountedQuantityNonNegative"].Value;
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.Reason))
        {
            _errorMessage = Localizer["Common.ReasonRequired"].Value;
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            AdjustInventoryBalanceRequest request = new(
                _model.StockKeepingUnitId,
                _model.StorageLocationId,
                _model.CountedQuantity,
                _model.Reason,
                ExpectedBalanceVersion: null);

            ApiResult<InventoryBalanceDetails> result = await WmsInventoryApiClient
                .TryAdjustInventoryBalanceAsync(request);

            if (result.IsFailure)
            {
                if (IsConcurrencyConflict(result.Error))
                {
                    _hasConcurrencyConflict = true;
                    _errorMessage = Localizer["InventoryBalance.InitialCountConcurrencyConflict"].Value;
                    return;
                }

                _errorMessage = result.Error?.Message ?? Localizer["InventoryBalance.InitialCountError"].Value;
                return;
            }

            if (result.Value is null)
            {
                _errorMessage = Localizer["InventoryBalance.MissingResult"].Value;
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        if (_hasConcurrencyConflict)
        {
            MudDialog.Close(DialogResult.Ok(InventoryBalanceDialogOutcome.ConcurrencyConflict));
            return;
        }

        MudDialog.Cancel();
    }

    private static bool IsConcurrencyConflict(ApiError? error)
    {
        return error is not null &&
               error.Status == 409 &&
               error.Extensions.TryGetValue("code", out string? code) &&
               code == ConcurrencyConflictCode;
    }

    private static string FormatStorageLocation(StorageLocationLookupItem? storageLocation) =>
        storageLocation is null ? string.Empty : $"{storageLocation.Code} - {storageLocation.Name}";

    private static string FormatStockKeepingUnit(StockKeepingUnitLookupItem? stockKeepingUnit) =>
        stockKeepingUnit is null ? string.Empty : $"{stockKeepingUnit.Code} - {stockKeepingUnit.Name}";

    private sealed class InitialCountInventoryBalanceModel
    {
        public Guid? StockKeepingUnitId { get; set; }

        public Guid? WarehouseId { get; set; }

        public Guid? StorageLocationId { get; set; }

        public decimal CountedQuantity { get; set; }

        public string? Reason { get; set; }
    }
}
