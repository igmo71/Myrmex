@using System.Globalization
@using Myrmex.Shared.Wms.Inventory
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["InventoryBalance.MoveTitle"]</MudText>
    </TitleContent>

    <DialogContent>
        @if (_result is null)
        {
            <MudForm @ref="_form">
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  Label="@Localizer["Common.Sku"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Value="@StockKeepingUnitDisplay"
                                  Disabled="true" />

                    <MudTextField T="string"
                                  Label="@Localizer["Common.Warehouse"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Value="@WarehouseDisplay"
                                  Disabled="true" />

                    <div class="operation-route">
                        <div class="operation-route__source">
                            <MudTextField T="string"
                                          Label="@Localizer["InventoryBalance.SourceLocation"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Output"
                                          Value="@SourceStorageLocationDisplay"
                                          Disabled="true" />
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                 Class="operation-route__arrow"
                                 aria-hidden="true" />
                        <div class="operation-route__destination">
                            <MudAutocomplete T="StorageLocationLookupItem"
                                             Label="@Localizer["InventoryBalance.DestinationLocation"]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.Input"
                                             Required="true"
                                             RequiredError="@Localizer["InventoryBalance.DestinationLocationRequired"]"
                                             Clearable="true"
                                             ShowProgressIndicator="true"
                                             MinCharacters="0"
                                             DebounceInterval="300"
                                             MaxItems="20"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="false"
                                             CoerceValue="false"
                                             Disabled="_isSaving || _hasConflict"
                                             Value="_destinationStorageLocation"
                                             ValueChanged="OnDestinationStorageLocationChanged"
                                             SearchFunc="SearchDestinationStorageLocationsAsync"
                                             ToStringFunc="FormatStorageLocation">
                                <ItemTemplate>
                                    <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
                                </ItemTemplate>
                                <NoItemsTemplate>
                                    <MudText>@Localizer["InventoryBalance.NoEligibleDestinations"]</MudText>
                                </NoItemsTemplate>
                            </MudAutocomplete>
                        </div>
                    </div>

                    <MudNumericField T="decimal"
                                     Label="@Localizer["InventoryBalance.CurrentQuantity"]"
                                     Value="InventoryBalance.Quantity"
                                     Disabled="true"
                                     Culture="@QuantityCulture"
                                     Format="0.##" />

                    <MudTextField T="string"
                                  Label="@Localizer["Sku.BaseUnitOfMeasure"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Value="@BaseUnitOfMeasureDisplay"
                                  Disabled="true" />

                    <MudNumericField T="decimal"
                                     Label="@Localizer["InventoryBalance.QuantityToMove"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Validation="@((Func<decimal, string?>)ValidatePositiveQuantity)"
                                     Max="@InventoryBalance.Quantity"
                                     Required="true"
                                     RequiredError="@Localizer["Common.QuantityRequired"]"
                                     Culture="@QuantityCulture"
                                     Format="0.##"
                                     InputMode="@(InputMode.@decimal)"
                                     Disabled="_isSaving || _hasConflict"
                                     @bind-Value="_quantity" />

                    <MudTextField T="string"
                                  Label="@Localizer["Common.Reason"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="@Localizer["Common.ReasonRequired"]"
                                  MaxLength="500"
                                  Lines="3"
                                  Disabled="_isSaving || _hasConflict"
                                  @bind-Value="_reason" />

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                            @_errorMessage
                        </MudAlert>
                    }
                </MudStack>
            </MudForm>
        }
        else
        {
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                    @Localizer["InventoryBalance.MoveSucceeded"]
                </MudAlert>

                <MudTextField T="string"
                              Label="@Localizer["InventoryBalance.MovedQuantity"]"
                              Value="@FormatQuantity(_result.MovedQuantity)"
                              Disabled="true" />

                <MudTextField T="string"
                              Label="@Localizer["Common.Source"]"
                              Value="@FormatBalanceResult(_result.SourceBalance, _result.SourceQuantityBefore, _result.SourceQuantityAfter)"
                              Disabled="true" />

                <MudTextField T="string"
                              Label="@Localizer["Common.Destination"]"
                              Value="@FormatBalanceResult(_result.DestinationBalance, _result.DestinationQuantityBefore, _result.DestinationQuantityAfter)"
                              Disabled="true" />
            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        @if (_result is null)
        {
            <MudButton OnClick="Cancel"
                       Disabled="_isSaving">
                @Localizer["Common.Close"]
            </MudButton>

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.SyncAlt"
                       OnClick="SaveAsync"
                       Disabled="_isSaving || _hasConflict">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true"
                                         Class="me-2" />
                }
                @Localizer["Common.Move"]
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="Done">
                @Localizer["Common.Done"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private const int AutocompleteTake = 20;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public InventoryBalanceDetails InventoryBalance { get; set; } = null!;

    [Inject]
    private WmsInventoryApiClient WmsInventoryApiClient { get; set; } = null!;

    [Inject]
    private WmsTopologyApiClient WmsTopologyApiClient { get; set; } = null!;

    private static readonly CultureInfo QuantityCulture =
        CultureInfo.CurrentCulture;

    private MudForm? _form;
    private StorageLocationLookupItem? _destinationStorageLocation;
    private decimal _quantity = 1;
    private string? _reason = "Manual move";
    private bool _isSaving;
    private bool _hasConflict;
    private string? _errorMessage;
    private MoveInventoryBalanceResult? _result;

    private string StockKeepingUnitDisplay =>
        $"{InventoryBalance.Sku.Code} - {InventoryBalance.Sku.Name}";

    private string WarehouseDisplay =>
        WarehouseDisplayFormatter.GetName(InventoryBalance.StorageLocation.Warehouse.Name, Localizer);

    private string SourceStorageLocationDisplay =>
        $"{InventoryBalance.StorageLocation.Code} - {InventoryBalance.StorageLocation.Name}";

    private string BaseUnitOfMeasureDisplay =>
        string.IsNullOrWhiteSpace(InventoryBalance.Sku.BaseUom.Symbol)
            ? InventoryBalance.Sku.BaseUom.Code
            : InventoryBalance.Sku.BaseUom.Symbol;

    private Task OnDestinationStorageLocationChanged(StorageLocationLookupItem? value)
    {
        _destinationStorageLocation =
            value is not null &&
            value.WarehouseId == InventoryBalance.StorageLocation.Warehouse.Id &&
            value.Id != InventoryBalance.StorageLocation.Id
                ? value
                : null;

        return Task.CompletedTask;
    }

    private async Task<IEnumerable<StorageLocationLookupItem>> SearchDestinationStorageLocationsAsync(
        string value,
        CancellationToken cancellationToken)
    {
        try
        {
            IReadOnlyList<StorageLocationLookupItem> items = await WmsTopologyApiClient
                .LookupStorageLocationsAsync(
                    InventoryBalance.StorageLocation.Warehouse.Id,
                    new LookupStorageLocationsRequest
                    {
                        SearchText = value,
                        Take = AutocompleteTake,
                        SelectableOnly = true,
                        ExcludeTransitTypes = true
                    },
                    cancellationToken);

            return items.Where(x => x.Id != InventoryBalance.StorageLocation.Id);
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            return [];
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        if (_destinationStorageLocation is null)
        {
            _errorMessage = Localizer["InventoryBalance.DestinationLocationRequired"];
            return;
        }

        if (_quantity <= 0 || _quantity > InventoryBalance.Quantity)
        {
            _errorMessage =
                Localizer["InventoryBalance.MoveQuantityRange"];
            return;
        }

        if (string.IsNullOrWhiteSpace(_reason))
        {
            _errorMessage = Localizer["Common.ReasonRequired"];
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            MoveInventoryBalanceRequest request = new(
                InventoryBalance.Sku.Id,
                InventoryBalance.StorageLocation.Id,
                _destinationStorageLocation.Id,
                _quantity,
                _reason,
                InventoryBalance.BalanceVersion);

            ApiResult<MoveInventoryBalanceResult> result =
                await WmsInventoryApiClient.TryMoveInventoryBalanceAsync(request);

            if (result.IsFailure)
            {
                if (result.Error?.Status == 409)
                {
                    _hasConflict = true;
                    _errorMessage =
                        Localizer["InventoryBalance.MoveConcurrencyConflict"];
                    return;
                }

                _errorMessage = result.Error?.Message ?? Localizer["InventoryBalance.MoveError"];
                return;
            }

            if (result.Value is null)
            {
                _errorMessage =
                    Localizer["InventoryBalance.MoveMissingResult"];
                return;
            }

            _result = result.Value;
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        if (_hasConflict)
        {
            MudDialog.Close(
                DialogResult.Ok(InventoryBalanceDialogOutcome.ConcurrencyConflict));
            return;
        }

        MudDialog.Cancel();
    }

    private void Done()
    {
        MudDialog.Close(DialogResult.Ok(_result));
    }

    private static string FormatStorageLocation(StorageLocationLookupItem? storageLocation) =>
        storageLocation is null
            ? string.Empty
            : $"{storageLocation.Code} - {storageLocation.Name}";

    private static string FormatBalanceResult(
        InventoryBalanceDetails balance,
        decimal before,
        decimal after) =>
        $"{balance.StorageLocation.Code} - {balance.StorageLocation.Name}: " +
        $"{FormatQuantity(before)} → {FormatQuantity(after)}";

    private static string FormatQuantity(decimal quantity) =>
        quantity.ToString("0.####", QuantityCulture);

        

    protected string? ValidatePositiveQuantity(decimal quantity) =>
        quantity > 0 ? null : Localizer["Common.QuantityMustBePositive"].Value;
}
