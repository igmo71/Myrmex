@using Myrmex.Shared.Wms.Inventory
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["InventoryLedger.TransactionDetailsTitle"]</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="6">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryLedger.TransactionType"]</MudText>
                    <MudText Typo="Typo.body2">@WmsDisplayFormatter.FormatTransactionType(Transaction.TransactionType, Localizer)</MudText>
                </MudStack>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="6">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryLedger.OccurredUtc"]</MudText>
                    <MudText Typo="Typo.body2">@WmsDisplayFormatter.FormatLocalDateTime(Transaction.OccurredAtUtc)</MudText>
                </MudStack>

                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Common.CreatedUtc"]</MudText>
                    <MudText Typo="Typo.body2">@WmsDisplayFormatter.FormatLocalDateTime(Transaction.CreatedAtUtc)</MudText>
                </MudStack>
            </MudStack>

            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Common.Reason"]</MudText>
                <MudText Typo="Typo.body2">@SourceDescription</MudText>
            </MudStack>

            <MudTable T="InventoryTransactionEntryDetails"
                      Items="Transaction.Entries"
                      Dense="true"
                      Hover="true"
                      Bordered="true"
                      Striped="true">
                <HeaderContent>
                    <MudTh>@Localizer["Common.Sku"]</MudTh>
                    <MudTh>@Localizer["Common.Warehouse"]</MudTh>
                    <MudTh>@Localizer["Common.StorageLocation"]</MudTh>
                    <MudTh>@Localizer["InventoryLedger.Before"]</MudTh>
                    <MudTh>@Localizer["InventoryLedger.Delta"]</MudTh>
                    <MudTh>@Localizer["InventoryLedger.After"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["Common.Sku"]">
                        <WmsReference Name="@context.Sku.Name" Code="@context.Sku.Code" />
                    </MudTd>
                    <MudTd DataLabel="@Localizer["Common.Warehouse"]">
                        <WmsReference Name="@context.StorageLocation.Warehouse.Name" Code="@context.StorageLocation.Warehouse.Code" />
                    </MudTd>
                    <MudTd DataLabel="@Localizer["Common.StorageLocation"]">
                        <WmsReference Name="@context.StorageLocation.Name" Code="@context.StorageLocation.Code" />
                    </MudTd>
                    <MudTd DataLabel="@Localizer["InventoryLedger.Before"]">@WmsDisplayFormatter.FormatQuantity(context.BalanceBefore)</MudTd>
                    <MudTd DataLabel="@Localizer["InventoryLedger.Delta"]">@WmsDisplayFormatter.FormatSignedQuantity(context.QuantityDelta)</MudTd>
                    <MudTd DataLabel="@Localizer["InventoryLedger.After"]">@WmsDisplayFormatter.FormatQuantity(context.BalanceAfter)</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@Localizer["InventoryLedger.NoTransactionEntries"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Close">
            @Localizer["Common.Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public InventoryTransactionDetails Transaction { get; set; } = null!;

    private void Close()
    {
        MudDialog.Close();
    }

    private string SourceDescription => Transaction.Source switch
    {
        { SourceType: "ReceivingOrder", DocumentNumber: not null, DocumentCreatedAtUtc: not null } source =>
            Localizer["InventoryTransaction.Source.Receiving", source.DocumentNumber, WmsDisplayFormatter.FormatLocalDateTime(source.DocumentCreatedAtUtc.Value)],
        { SourceType: "InventoryTransfer", DocumentNumber: not null, DocumentCreatedAtUtc: not null } source =>
            Localizer["InventoryTransaction.Source.Transfer", source.DocumentNumber, WmsDisplayFormatter.FormatLocalDateTime(source.DocumentCreatedAtUtc.Value)],
        _ => Transaction.Reason
    };
}
