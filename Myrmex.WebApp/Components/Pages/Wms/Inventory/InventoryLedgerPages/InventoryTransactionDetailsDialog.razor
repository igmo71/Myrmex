@using System.Globalization
@using Myrmex.Shared.Wms.Inventory
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["InventoryLedger.TransactionDetailsTitle"]</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="6">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryLedger.TransactionId"]</MudText>
                    <MudText Typo="Typo.body2">@Transaction.Id</MudText>
                </MudStack>

                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryLedger.TransactionType"]</MudText>
                    <MudText Typo="Typo.body2">@Transaction.TransactionType</MudText>
                </MudStack>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="6">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryLedger.OccurredUtc"]</MudText>
                    <MudText Typo="Typo.body2">@FormatTimestamp(Transaction.OccurredAtUtc)</MudText>
                </MudStack>

                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Common.CreatedUtc"]</MudText>
                    <MudText Typo="Typo.body2">@FormatTimestamp(Transaction.CreatedAtUtc)</MudText>
                </MudStack>
            </MudStack>

            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Common.Reason"]</MudText>
                <MudText Typo="Typo.body2">@Transaction.Reason</MudText>
            </MudStack>

            <MudTable T="InventoryTransactionEntryDetails"
                      Items="Transaction.Entries"
                      Dense="true"
                      Hover="true"
                      Bordered="true"
                      Striped="true">
                <HeaderContent>
                    <MudTh>@Localizer["Common.Sku"]</MudTh>
                    <MudTh>@Localizer["Common.Warehouse"]</MudTh>
                    <MudTh>@Localizer["Common.StorageLocation"]</MudTh>
                    <MudTh>@Localizer["InventoryLedger.Before"]</MudTh>
                    <MudTh>@Localizer["InventoryLedger.Delta"]</MudTh>
                    <MudTh>@Localizer["InventoryLedger.After"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["Common.Sku"]">
                        <MudText Typo="Typo.body2">@context.Sku.Code</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @context.Sku.Name - @GetBaseUnitOfMeasureDisplay(context)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["Common.Warehouse"]">
                        @WarehouseDisplayFormatter.GetName(context.StorageLocation.Warehouse.Name, Localizer)
                    </MudTd>
                    <MudTd DataLabel="@Localizer["Common.StorageLocation"]">
                        <MudText Typo="Typo.body2">@context.StorageLocation.Code</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @context.StorageLocation.Name
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["InventoryLedger.Before"]">@FormatQuantity(context.BalanceBefore)</MudTd>
                    <MudTd DataLabel="@Localizer["InventoryLedger.Delta"]">@FormatSignedQuantity(context.QuantityDelta)</MudTd>
                    <MudTd DataLabel="@Localizer["InventoryLedger.After"]">@FormatQuantity(context.BalanceAfter)</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@Localizer["InventoryLedger.NoTransactionEntries"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Close">
            @Localizer["Common.Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public InventoryTransactionDetails Transaction { get; set; } = null!;

    private static CultureInfo QuantityCulture => CultureInfo.CurrentCulture;

    private void Close()
    {
        MudDialog.Close();
    }

    private static string FormatTimestamp(DateTimeOffset value) =>
        value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);

    private static string FormatQuantity(decimal value) =>
        value.ToString("0.####", QuantityCulture);

    private static string FormatSignedQuantity(decimal value) =>
        value > 0 ? $"+{FormatQuantity(value)}" : FormatQuantity(value);

    private static string GetBaseUnitOfMeasureDisplay(InventoryTransactionEntryDetails entry)
    {
        return string.IsNullOrWhiteSpace(entry.Sku.BaseUom.Symbol)
            ? entry.Sku.BaseUom.Code
            : entry.Sku.BaseUom.Symbol;
    }
}
