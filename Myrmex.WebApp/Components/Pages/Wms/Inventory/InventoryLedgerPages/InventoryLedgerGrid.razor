@using Myrmex.Shared.Wms.Inventory
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="InventoryLedgerEntryDetails"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Single"
             Filterable="false">
    <Columns>
        <TemplateColumn Title="@Localizer["InventoryLedger.OccurredUtc"]"
                        Tag="@InventoryLedgerSortBy.OccurredAtUtc"
                        SortBy="@(entry => entry.OccurredAtUtc)"
                        Sortable="true">
            <CellTemplate>
                @WmsDisplayFormatter.FormatLocalDateTime(context.Item.OccurredAtUtc)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Type"]"
                        Tag="@InventoryLedgerSortBy.TransactionType"
                        SortBy="@(entry => entry.TransactionType)"
                        Sortable="true">
            <CellTemplate>
                @WmsDisplayFormatter.FormatTransactionType(context.Item.TransactionType, Localizer)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Sku"]"
                        Tag="@InventoryLedgerSortBy.SkuCode"
                        SortBy="@(entry => entry.Sku.Code)"
                        Sortable="true">
            <CellTemplate>
                <WmsReference Name="@context.Item.Sku.Name" Code="@context.Item.Sku.Code" />
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Warehouse"]"
                        Tag="@InventoryLedgerSortBy.WarehouseName"
                        SortBy="@(entry => entry.StorageLocation.Warehouse.Name)"
                        Sortable="true">
            <CellTemplate>
                <WmsReference Name="@context.Item.StorageLocation.Warehouse.Name" Code="@context.Item.StorageLocation.Warehouse.Code" Fallback="@Localizer["Common.NotAvailable"]" />
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.StorageLocation"]"
                        Tag="@InventoryLedgerSortBy.StorageLocationCode"
                        SortBy="@(entry => entry.StorageLocation.Code)"
                        Sortable="true">
            <CellTemplate>
                <WmsReference Name="@context.Item.StorageLocation.Name" Code="@context.Item.StorageLocation.Code" />
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["InventoryLedger.Before"]"
                        Tag="@InventoryLedgerSortBy.BalanceBefore"
                        SortBy="@(entry => entry.BalanceBefore)"
                        Sortable="true">
            <CellTemplate>
                @WmsDisplayFormatter.FormatQuantity(context.Item.BalanceBefore) @WmsDisplayFormatter.FormatUom(context.Item.Sku.BaseUom.Symbol, null, context.Item.Sku.BaseUom.Code, Localizer)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["InventoryLedger.Delta"]"
                        Tag="@InventoryLedgerSortBy.QuantityDelta"
                        SortBy="@(entry => entry.QuantityDelta)"
                        Sortable="true">
            <CellTemplate>
                @WmsDisplayFormatter.FormatSignedQuantity(context.Item.QuantityDelta) @WmsDisplayFormatter.FormatUom(context.Item.Sku.BaseUom.Symbol, null, context.Item.Sku.BaseUom.Code, Localizer)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["InventoryLedger.After"]"
                        Tag="@InventoryLedgerSortBy.BalanceAfter"
                        SortBy="@(entry => entry.BalanceAfter)"
                        Sortable="true">
            <CellTemplate>
                @WmsDisplayFormatter.FormatQuantity(context.Item.BalanceAfter) @WmsDisplayFormatter.FormatUom(context.Item.Sku.BaseUom.Symbol, null, context.Item.Sku.BaseUom.Code, Localizer)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Reason"]"
                        Tag="@InventoryLedgerSortBy.Reason"
                        SortBy="@(entry => entry.Reason)"
                        Sortable="true">
            <CellTemplate>
                <MudText Typo="Typo.body2" Style="max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @context.Item.Reason
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Actions"]"
                        Sortable="false">
            <CellTemplate>
                <MudTooltip Text="@Localizer["InventoryLedger.ViewTransactionDetails"]">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   aria-label="@Localizer["InventoryLedger.ViewTransactionDetails"]"
                                   OnClick="@(() => DetailsRequested.InvokeAsync(context.Item))" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <NoRecordsContent>
        <MudText>@Localizer["InventoryLedger.NoMatches"]</MudText>
    </NoRecordsContent>

    <PagerContent>
        <MudDataGridPager T="InventoryLedgerEntryDetails" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public Func<InventoryLedgerGridRequest, CancellationToken, Task<GridData<InventoryLedgerEntryDetails>>> LoadData { get; set; } = default!;

    [Parameter]
    public EventCallback<InventoryLedgerEntryDetails> DetailsRequested { get; set; }

    private MudDataGrid<InventoryLedgerEntryDetails>? _dataGrid;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private Task<GridData<InventoryLedgerEntryDetails>> LoadServerDataAsync(
        GridState<InventoryLedgerEntryDetails> state,
        CancellationToken cancellationToken)
    {
        SortDefinition<InventoryLedgerEntryDetails>? sortDefinition =
            state.SortDefinitions.FirstOrDefault();

        InventoryLedgerGridRequest request = new(
            Skip: state.Page * state.PageSize,
            Take: state.PageSize,
            SortBy: ResolveSortBy(sortDefinition),
            SortDescending: sortDefinition?.Descending ?? true);

        return LoadData(request, cancellationToken);
    }

    private string ResolveSortBy(SortDefinition<InventoryLedgerEntryDetails>? sortDefinition)
    {
        if (sortDefinition is null)
        {
            return string.Empty;
        }

        Column<InventoryLedgerEntryDetails>? column =
            _dataGrid?.GetColumnByPropertyName(sortDefinition.SortBy);

        return column?.Tag as string
            ?? string.Empty;
    }

    public async Task ReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        await _dataGrid.ReloadServerData();
    }

    public async Task ResetAndReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        if (_dataGrid.CurrentPage == 0)
        {
            await _dataGrid.ReloadServerData();
            return;
        }

        _dataGrid.NavigateTo(Page.First);
    }

}
