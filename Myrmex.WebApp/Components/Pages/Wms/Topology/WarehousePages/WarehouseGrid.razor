@using MudBlazor
@using Myrmex.Shared.Wms.Topology
@using Myrmex.WebApp.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="WarehouseDetails"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Single"
             Filterable="false">
    <Columns>
        <TemplateColumn Title="@Localizer["Common.Name"]"
                        Tag="@WarehouseSortBy.Name"
                        SortBy="@(warehouse => warehouse.Name)"
                        Sortable="true">
            <CellTemplate>
                @WarehouseDisplayFormatter.GetName(context.Item.Name, Localizer)
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Description"
                        Title="@Localizer["Common.Description"]"
                        Sortable="false" />

        <TemplateColumn Title="@Localizer["Common.Active"]"
                        Sortable="false"
                        Filterable="false"
                        CellClass="d-flex justify-center">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudTooltip Text="@Localizer["Common.Active"]">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@Localizer["Common.Inactive"]">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.CreatedAtUtc"
                        Title="@Localizer["Common.CreatedUtc"]"
                        Tag="@WarehouseSortBy.CreatedAtUtc" />
        <PropertyColumn Property="x => x.UpdatedAtUtc"
                        Title="@Localizer["Common.UpdatedUtc"]"
                        Tag="@WarehouseSortBy.UpdatedAtUtc" />

        <TemplateColumn Title="@Localizer["Common.Actions"]" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => EditRequested.InvokeAsync(context.Item))">
                        @Localizer["Common.Edit"]
                    </MudMenuItem>

                    @if (context.Item.IsActive)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Error"
                                     OnClick="@(() => DeactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Deactivate"]
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Restore"
                                     IconColor="Color.Success"
                                     OnClick="@(() => ReactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Reactivate"]
                        </MudMenuItem>
                    }

                    <MudDivider />

                    <MudMenuItem Icon="@Icons.Material.Filled.AccountTree"
                                 OnClick="@(() => ZonesRequested.InvokeAsync(context.Item))">
                        @Localizer["Zone.Heading"]
                    </MudMenuItem>

                    <MudMenuItem Icon="@Icons.Material.Filled.LocationOn"
                                 OnClick="@(() => LocationsRequested.InvokeAsync(context.Item))">
                        @Localizer["StorageLocation.Heading"]
                    </MudMenuItem>
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="WarehouseDetails" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public Func<WarehouseGridRequest, CancellationToken, Task<GridData<WarehouseDetails>>> LoadData { get; set; } = default!;

    [Parameter]
    public EventCallback<WarehouseDetails> EditRequested { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> DeactivateRequested { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> ReactivateRequested { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> ZonesRequested { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> LocationsRequested { get; set; }

    private MudDataGrid<WarehouseDetails>? _dataGrid;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private Task<GridData<WarehouseDetails>> LoadServerDataAsync(
        GridState<WarehouseDetails> state,
        CancellationToken cancellationToken)
    {
        SortDefinition<WarehouseDetails>? sortDefinition = state.SortDefinitions.FirstOrDefault();

        WarehouseGridRequest request = new(
            Skip: state.Page * state.PageSize,
            Take: state.PageSize,
            SortBy: ResolveSortBy(sortDefinition),
            SortDescending: sortDefinition?.Descending ?? false);

        return LoadData(request, cancellationToken);
    }

    private string ResolveSortBy(SortDefinition<WarehouseDetails>? sortDefinition)
    {
        if (sortDefinition is null)
        {
            return "name";
        }

        Column<WarehouseDetails>? column = _dataGrid?.GetColumnByPropertyName(sortDefinition.SortBy);

        return column?.Tag as string ?? "name";
    }

    public Task ReloadServerDataAsync()
    {
        return _dataGrid?.ReloadServerData() ?? Task.CompletedTask;
    }

    public async Task ResetAndReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        if (_dataGrid.CurrentPage == 0)
        {
            await _dataGrid.ReloadServerData();
            return;
        }

        _dataGrid.NavigateTo(Page.First);
    }
}
