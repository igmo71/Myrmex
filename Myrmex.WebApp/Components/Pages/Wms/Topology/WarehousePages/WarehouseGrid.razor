@using MudBlazor
@using Myrmex.WebApp.Wms.Topology

<MudDataGrid T="WarehouseDetails"
             Items="Warehouses"
             Loading="IsLoading"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Multiple"
             Filterable="false">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="Code" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Description" Title="Description" />

        <TemplateColumn Title="Active"
                        Sortable="false"
                        Filterable="false"
                        CellClass="d-flex justify-center">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudTooltip Text="Active">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Inactive">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.CreatedAtUtc" Title="Created UTC" />
        <PropertyColumn Property="x => x.UpdatedAtUtc" Title="Updated UTC" />

        <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => EditRequested.InvokeAsync(context.Item))">
                        Edit
                    </MudMenuItem>

                    @if (context.Item.IsActive)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Error"
                                     OnClick="@(() => DeactivateRequested.InvokeAsync(context.Item))">
                            Deactivate
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Restore"
                                     IconColor="Color.Success"
                                     OnClick="@(() => ReactivateRequested.InvokeAsync(context.Item))">
                            Reactivate
                        </MudMenuItem>
                    }

                    <MudDivider />

                    <MudMenuItem Icon="@Icons.Material.Filled.AccountTree"
                                 OnClick="@(() => ZonesRequested.InvokeAsync(context.Item))">
                        Zones
                    </MudMenuItem>

                    <MudMenuItem Icon="@Icons.Material.Filled.LocationOn"
                                 OnClick="@(() => LocationsRequested.InvokeAsync(context.Item))">
                        Locations
                    </MudMenuItem>
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="WarehouseDetails" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter]
    public IReadOnlyList<WarehouseDetails> Warehouses { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> EditRequested { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> DeactivateRequested { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> ReactivateRequested { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> ZonesRequested { get; set; }

    [Parameter]
    public EventCallback<WarehouseDetails> LocationsRequested { get; set; }
}
