@page "/wms/topology/warehouses"

@using MudBlazor

<PageTitle>WMS Warehouses</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">Warehouses</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					WMS topology warehouses.
				</MudText>
			</div>

			<MudStack Row="true" Spacing="2">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="CreateWarehouseAsync"
						   Disabled="_isLoading">
					Create
				</MudButton>

				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Refresh"
						   OnClick="ReloadAsync"
						   Disabled="_isLoading">
					Refresh
				</MudButton>
			</MudStack>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<WarehouseFilters SearchText="@_searchText"
						  SearchTextChanged="OnSearchTextChanged"
						  IncludeInactive="@_includeInactive"
						  IncludeInactiveChanged="OnIncludeInactiveChanged" />

		<WarehouseGrid Warehouses="@_warehouses"
					   IsLoading="@_isLoading"
					   EditRequested="EditWarehouseAsync"
					   DeactivateRequested="DeactivateWarehouseAsync"
					   ReactivateRequested="ReactivateWarehouseAsync"
					   ZonesRequested="OnZonesRequested"
					   LocationsRequested="OnLocationsRequested" />
	</MudStack>
</MudContainer>
