@page "/wms/topology/warehouses"
@rendermode InteractiveServer

@using MudBlazor
@using Myrmex.WebApp.Wms.Topology

@inject WmsTopologyApiClient WmsTopologyApiClient
@inject NavigationManager NavigationManager

<PageTitle>WMS Warehouses</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">Warehouses</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					WMS topology warehouses.
				</MudText>
			</div>

			<MudButton Variant="Variant.Filled"
					   Color="Color.Primary"
					   StartIcon="@Icons.Material.Filled.Refresh"
					   OnClick="ReloadAsync"
					   Disabled="_isLoading">
				Refresh
			</MudButton>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<MudPaper Class="pa-4">
			<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
				<MudTextField T="string"
							  Label="Search"
							  Variant="Variant.Outlined"
							  Margin="Margin.Dense"
							  Clearable="true"
							  Value="_searchText"
							  ValueChanged="OnSearchTextChanged"
							  Adornment="Adornment.Start"
							  AdornmentIcon="@Icons.Material.Filled.Search"
							  Class="flex-grow-1" />

				<MudSwitch T="bool"
						   Label="Include inactive"
						   Color="Color.Primary"
						   Value="_includeInactive"
						   ValueChanged="OnIncludeInactiveChanged" />
			</MudStack>
		</MudPaper>

		<MudDataGrid T="WarehouseDetails"
					 Items="_warehouses"
					 Loading="_isLoading"
					 Dense="true"
					 Hover="true"
					 Bordered="true"
					 Striped="true"
					 SortMode="SortMode.Multiple"
					 Filterable="false">
			<Columns>
				<PropertyColumn Property="x => x.Code" Title="Code" />
				<PropertyColumn Property="x => x.Name" Title="Name" />
				<PropertyColumn Property="x => x.Description" Title="Description" />
				<PropertyColumn Property="x => x.IsActive" Title="Active" />
				<PropertyColumn Property="x => x.CreatedAtUtc" Title="Created UTC" />
				<PropertyColumn Property="x => x.UpdatedAtUtc" Title="Updated UTC" />

				<TemplateColumn Title="Actions" Sortable="false" Filterable="false">
					<CellTemplate>
						<MudStack Row="true" Spacing="1">
							<MudButton Size="Size.Small"
									   Variant="Variant.Text"
									   Color="Color.Primary"
									   OnClick="@(() => NavigateToZones(context.Item.Id))">
								Zones
							</MudButton>

							<MudButton Size="Size.Small"
									   Variant="Variant.Text"
									   Color="Color.Primary"
									   OnClick="@(() => NavigateToLocations(context.Item.Id))">
								Locations
							</MudButton>
						</MudStack>
					</CellTemplate>
				</TemplateColumn>
			</Columns>

			<PagerContent>
				<MudDataGridPager T="WarehouseDetails" />
			</PagerContent>
		</MudDataGrid>
	</MudStack>
</MudContainer>

@code {
	private List<WarehouseDetails> _warehouses = [];
	private bool _isLoading;
	private string? _errorMessage;
	private string? _searchText;
	private bool _includeInactive;

	protected override async Task OnInitializedAsync()
	{
		await LoadWarehousesAsync();
	}

	private async Task ReloadAsync()
	{
		await LoadWarehousesAsync();
	}

	private async Task OnSearchTextChanged(string? value)
	{
		_searchText = value;
		await LoadWarehousesAsync();
	}

	private async Task OnIncludeInactiveChanged(bool value)
	{
		_includeInactive = value;
		await LoadWarehousesAsync();
	}

	private async Task LoadWarehousesAsync()
	{
		_isLoading = true;
		_errorMessage = null;

		try
		{
			var request = new ListRequest(
				Skip: 0,
				Take: 100,
				SearchText: _searchText,
				SortBy: "code",
				SortDescending: false,
				IncludeInactive: _includeInactive);

			ListResult<WarehouseDetails> result = await WmsTopologyApiClient.ListWarehousesAsync(request);

			_warehouses = result.Items.ToList();
		}
		catch (Exception exception)
		{
			_errorMessage = exception.Message;
			_warehouses = [];
		}
		finally
		{
			_isLoading = false;
		}
	}

	private void NavigateToZones(Guid warehouseId)
	{
		NavigationManager.NavigateTo($"/wms/topology/zones?warehouseId={warehouseId}");
	}

	private void NavigateToLocations(Guid warehouseId)
	{
		NavigationManager.NavigateTo($"/wms/topology/locations?warehouseId={warehouseId}");
	}
}