@page "/wms/topology/warehouses"

@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Warehouse.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">@Localizer["Warehouse.Heading"]</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					@Localizer["Warehouse.Description"]
				</MudText>
			</div>

			<MudStack Row="true" Spacing="2">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="CreateWarehouseAsync">
					@Localizer["Common.Create"]
				</MudButton>

				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Refresh"
						   OnClick="ReloadAsync">
					@Localizer["Common.Refresh"]
				</MudButton>
			</MudStack>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<WarehouseFilters SearchText="@_searchText"
						  SearchTextChanged="OnSearchTextChanged"
						  IncludeInactive="@_includeInactive"
						  IncludeInactiveChanged="OnIncludeInactiveChanged" />

		<WarehouseGrid @ref="_warehouseGrid"
					   LoadData="LoadWarehousesAsync"
					   EditRequested="EditWarehouseAsync"
					   DeactivateRequested="DeactivateWarehouseAsync"
					   ReactivateRequested="ReactivateWarehouseAsync"
					   ZonesRequested="OnZonesRequested"
					   LocationsRequested="OnLocationsRequested" />
	</MudStack>
</MudContainer>
