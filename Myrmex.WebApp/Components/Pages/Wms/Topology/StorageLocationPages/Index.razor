@page "/wms/topology/locations"

@using MudBlazor
@using Myrmex.WebApp.Wms.Topology

<PageTitle>WMS Storage Locations</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">Storage Locations</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					WMS warehouse storage locations.
				</MudText>
			</div>

			<MudStack Row="true" Spacing="2">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="CreateStorageLocationAsync"
						   Disabled="_isLoading || _selectedWarehouseId is null || _selectedZoneId is null">
					Create
				</MudButton>

				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Refresh"
						   OnClick="ReloadAsync"
						   Disabled="_isLoading">
					Refresh
				</MudButton>
			</MudStack>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<MudPaper Class="pa-4">
			<MudStack Spacing="2">
				<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
					<MudSelect T="Guid?"
							   Label="Warehouse"
							   Variant="Variant.Outlined"
							   Margin="Margin.Dense"
							   Clearable="true"
							   Value="_selectedWarehouseId"
							   ValueChanged="OnWarehouseChanged"
							   Disabled="_isLoadingWarehouses"
							   Class="min-width-300">
						@foreach (WarehouseDetails warehouse in _warehouses)
						{
							<MudSelectItem T="Guid?" Value="@warehouse.Id">
								@warehouse.Code - @warehouse.Name
							</MudSelectItem>
						}
					</MudSelect>

					<MudSelect T="Guid?"
							   Label="Zone"
							   Variant="Variant.Outlined"
							   Margin="Margin.Dense"
							   Clearable="true"
							   Value="_selectedZoneId"
							   ValueChanged="OnZoneChanged"
							   Disabled="_selectedWarehouseId is null || _isLoadingZones"
							   Class="min-width-300">
						@foreach (ZoneDetails zone in _zones)
						{
							<MudSelectItem T="Guid?" Value="@zone.Id">
								@zone.Code - @zone.Name
							</MudSelectItem>
						}
					</MudSelect>

					<MudTextField T="string"
								  Label="Search"
								  Variant="Variant.Outlined"
								  Margin="Margin.Dense"
								  Clearable="true"
								  Value="_searchText"
								  ValueChanged="OnSearchTextChanged"
								  Adornment="Adornment.Start"
								  AdornmentIcon="@Icons.Material.Filled.Search"
								  Class="flex-grow-1" />
				</MudStack>

				<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
					<MudSelect T="Guid?"
							   Label="Type"
							   Variant="Variant.Outlined"
							   Margin="Margin.Dense"
							   Clearable="true"
							   Value="_selectedStorageLocationTypeId"
							   ValueChanged="OnStorageLocationTypeChanged"
							   Disabled="_isLoadingLookups"
							   Class="min-width-300">
						@foreach (StorageLocationTypeDetails type in _storageLocationTypes)
						{
							<MudSelectItem T="Guid?" Value="@type.Id">
								@type.Code - @type.Name
							</MudSelectItem>
						}
					</MudSelect>

					<MudSelect T="Guid?"
							   Label="Status"
							   Variant="Variant.Outlined"
							   Margin="Margin.Dense"
							   Clearable="true"
							   Value="_selectedStorageLocationStatusId"
							   ValueChanged="OnStorageLocationStatusChanged"
							   Disabled="_isLoadingLookups"
							   Class="min-width-300">
						@foreach (StorageLocationStatusDetails status in _storageLocationStatuses)
						{
							<MudSelectItem T="Guid?" Value="@status.Id">
								@status.Code - @status.Name
							</MudSelectItem>
						}
					</MudSelect>

					<MudSwitch T="bool"
							   Label="Include inactive"
							   Color="Color.Primary"
							   Value="_includeInactive"
							   ValueChanged="OnIncludeInactiveChanged" />
				</MudStack>
			</MudStack>
		</MudPaper>

		@if (_selectedWarehouseId is null)
		{
			<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
				Select a warehouse to view storage locations.
			</MudAlert>
		}
		else
		{
			<MudDataGrid T="StorageLocationDetails"
						 Items="FilteredStorageLocations"
						 Loading="_isLoading"
						 Dense="true"
						 Hover="true"
						 Bordered="true"
						 Striped="true"
						 SortMode="SortMode.Multiple"
						 Filterable="false">
				<Columns>
					<PropertyColumn Property="x => x.Code" Title="Code" />
					<PropertyColumn Property="x => x.Name" Title="Name" />
					<PropertyColumn Property="x => x.Description" Title="Description" />

					<TemplateColumn Title="Type" Sortable="false" Filterable="false">
						<CellTemplate>
							@GetStorageLocationTypeDisplayName(context.Item.StorageLocationTypeId)
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="Status" Sortable="false" Filterable="false">
						<CellTemplate>
							@GetStorageLocationStatusDisplayName(context.Item.StorageLocationStatusId)
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="Pickable" Sortable="false" Filterable="false">
						<CellTemplate>
							@if (context.Item.IsPickable)
							{
								<MudTooltip Text="Pickable">
									<MudIcon Icon="@Icons.Material.Filled.CheckCircle"
											 Color="Color.Success" />
								</MudTooltip>
							}
							else
							{
								<MudTooltip Text="Not pickable">
									<MudIcon Icon="@Icons.Material.Filled.Cancel"
											 Color="Color.Error" />
								</MudTooltip>
							}
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="Active" Sortable="false" Filterable="false">
						<CellTemplate>
							@if (context.Item.IsActive)
							{
								<MudTooltip Text="Active">
									<MudIcon Icon="@Icons.Material.Filled.CheckCircle"
											 Color="Color.Success" />
								</MudTooltip>
							}
							else
							{
								<MudTooltip Text="Inactive">
									<MudIcon Icon="@Icons.Material.Filled.Cancel"
											 Color="Color.Error" />
								</MudTooltip>
							}
						</CellTemplate>
					</TemplateColumn>

					<PropertyColumn Property="x => x.CreatedAtUtc" Title="Created UTC" />
					<PropertyColumn Property="x => x.UpdatedAtUtc" Title="Updated UTC" />

					<TemplateColumn Title="Actions" Sortable="false" Filterable="false">
						<CellTemplate>
							<MudMenu Icon="@Icons.Material.Filled.MoreVert"
									 Size="Size.Small"
									 Dense="true"
									 AnchorOrigin="Origin.BottomRight"
									 TransformOrigin="Origin.TopRight">

								<MudMenuItem Icon="@Icons.Material.Filled.Edit"
											 OnClick="@(() => EditStorageLocationAsync(context.Item))">
									Edit
								</MudMenuItem>

								@if (context.Item.IsActive)
								{
									<MudMenuItem Icon="@Icons.Material.Filled.Block"
												 IconColor="Color.Error"
												 OnClick="@(() => DeactivateStorageLocationAsync(context.Item))">
										Deactivate
									</MudMenuItem>
								}
								else
								{
									<MudMenuItem Icon="@Icons.Material.Filled.Restore"
												 IconColor="Color.Success"
												 OnClick="@(() => ReactivateStorageLocationAsync(context.Item))">
										Reactivate
									</MudMenuItem>
								}
							</MudMenu>
						</CellTemplate>
					</TemplateColumn>
				</Columns>

				<PagerContent>
					<MudDataGridPager T="StorageLocationDetails" />
				</PagerContent>
			</MudDataGrid>
		}
	</MudStack>
</MudContainer>