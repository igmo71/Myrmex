@page "/wms/topology/locations"

@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["StorageLocation.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">@Localizer["StorageLocation.Heading"]</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					@Localizer["StorageLocation.Description"]
				</MudText>
			</div>

			<MudStack Row="true" Spacing="2">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="CreateStorageLocationAsync"
						   Disabled="_selectedWarehouseId is null || _selectedZoneId is null">
					@Localizer["Common.Create"]
				</MudButton>

				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Refresh"
						   OnClick="ReloadAsync">
					@Localizer["Common.Refresh"]
				</MudButton>
			</MudStack>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<StorageLocationFilters Warehouses="@_warehouses"
								Zones="@_zones"
								StorageLocationTypes="@_storageLocationTypes"
								StorageLocationStatuses="@_storageLocationStatuses"
								SelectedWarehouseId="@_selectedWarehouseId"
								SelectedWarehouseIdChanged="OnWarehouseChanged"
								SelectedZoneId="@_selectedZoneId"
								SelectedZoneIdChanged="OnZoneChanged"
								SelectedStorageLocationTypeId="@_selectedStorageLocationTypeId"
								SelectedStorageLocationTypeIdChanged="OnStorageLocationTypeChanged"
								SelectedStorageLocationStatusId="@_selectedStorageLocationStatusId"
								SelectedStorageLocationStatusIdChanged="OnStorageLocationStatusChanged"
								IsLoadingWarehouses="@_isLoadingWarehouses"
								IsLoadingZones="@_isLoadingZones"
								IsLoadingLookups="@_isLoadingLookups"
								SearchText="@_searchText"
								SearchTextChanged="OnSearchTextChanged"
								IncludeInactive="@_includeInactive"
								IncludeInactiveChanged="OnIncludeInactiveChanged" />

		@if (_selectedWarehouseId is null)
		{
			<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
				@Localizer["StorageLocation.SelectWarehousePrompt"]
			</MudAlert>
		}
		else
		{
			<StorageLocationGrid @ref="_storageLocationGrid"
								 LoadData="LoadStorageLocationsAsync"
								 StorageLocationTypes="@_storageLocationTypes"
								 StorageLocationStatuses="@_storageLocationStatuses"
								 EditRequested="EditStorageLocationAsync"
								 DeactivateRequested="DeactivateStorageLocationAsync"
								 ReactivateRequested="ReactivateStorageLocationAsync" />
		}
	</MudStack>
</MudContainer>
