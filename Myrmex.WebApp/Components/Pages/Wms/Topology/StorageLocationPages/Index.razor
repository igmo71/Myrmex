@page "/wms/topology/locations"

@using MudBlazor
@using Myrmex.WebApp.Wms.Topology

<PageTitle>WMS Storage Locations</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">Storage Locations</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					WMS warehouse storage locations.
				</MudText>
			</div>

			<MudStack Row="true" Spacing="2">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="CreateStorageLocationAsync"
						   Disabled="_isLoading || _selectedWarehouseId is null || _selectedZoneId is null">
					Create
				</MudButton>

				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Refresh"
						   OnClick="ReloadAsync"
						   Disabled="_isLoading">
					Refresh
				</MudButton>
			</MudStack>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<StorageLocationFilters Warehouses="@_warehouses"
								Zones="@_zones"
								StorageLocationTypes="@_storageLocationTypes"
								StorageLocationStatuses="@_storageLocationStatuses"
								SelectedWarehouseId="@_selectedWarehouseId"
								SelectedWarehouseIdChanged="OnWarehouseChanged"
								SelectedZoneId="@_selectedZoneId"
								SelectedZoneIdChanged="OnZoneChanged"
								SelectedStorageLocationTypeId="@_selectedStorageLocationTypeId"
								SelectedStorageLocationTypeIdChanged="OnStorageLocationTypeChanged"
								SelectedStorageLocationStatusId="@_selectedStorageLocationStatusId"
								SelectedStorageLocationStatusIdChanged="OnStorageLocationStatusChanged"
								IsLoadingWarehouses="@_isLoadingWarehouses"
								IsLoadingZones="@_isLoadingZones"
								IsLoadingLookups="@_isLoadingLookups"
								SearchText="@_searchText"
								SearchTextChanged="OnSearchTextChanged"
								IncludeInactive="@_includeInactive"
								IncludeInactiveChanged="OnIncludeInactiveChanged" />

		@if (_selectedWarehouseId is null)
		{
			<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
				Select a warehouse to view storage locations.
			</MudAlert>
		}
		else
		{
			<MudDataGrid T="StorageLocationDetails"
						 Items="FilteredStorageLocations"
						 Loading="_isLoading"
						 Dense="true"
						 Hover="true"
						 Bordered="true"
						 Striped="true"
						 SortMode="SortMode.Multiple"
						 Filterable="false">
				<Columns>
					<PropertyColumn Property="x => x.Code" Title="Code" />
					<PropertyColumn Property="x => x.Name" Title="Name" />
					<PropertyColumn Property="x => x.Description" Title="Description" />

					<TemplateColumn Title="Type" Sortable="false" Filterable="false">
						<CellTemplate>
							@GetStorageLocationTypeDisplayName(context.Item.StorageLocationTypeId)
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="Status" Sortable="false" Filterable="false">
						<CellTemplate>
							@GetStorageLocationStatusDisplayName(context.Item.StorageLocationStatusId)
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="Pickable" Sortable="false" Filterable="false">
						<CellTemplate>
							@if (context.Item.IsPickable)
							{
								<MudTooltip Text="Pickable">
									<MudIcon Icon="@Icons.Material.Filled.CheckCircle"
											 Color="Color.Success" />
								</MudTooltip>
							}
							else
							{
								<MudTooltip Text="Not pickable">
									<MudIcon Icon="@Icons.Material.Filled.Cancel"
											 Color="Color.Error" />
								</MudTooltip>
							}
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="Active" Sortable="false" Filterable="false">
						<CellTemplate>
							@if (context.Item.IsActive)
							{
								<MudTooltip Text="Active">
									<MudIcon Icon="@Icons.Material.Filled.CheckCircle"
											 Color="Color.Success" />
								</MudTooltip>
							}
							else
							{
								<MudTooltip Text="Inactive">
									<MudIcon Icon="@Icons.Material.Filled.Cancel"
											 Color="Color.Error" />
								</MudTooltip>
							}
						</CellTemplate>
					</TemplateColumn>

					<PropertyColumn Property="x => x.CreatedAtUtc" Title="Created UTC" />
					<PropertyColumn Property="x => x.UpdatedAtUtc" Title="Updated UTC" />

					<TemplateColumn Title="Actions" Sortable="false" Filterable="false">
						<CellTemplate>
							<MudMenu Icon="@Icons.Material.Filled.MoreVert"
									 Size="Size.Small"
									 Dense="true"
									 AnchorOrigin="Origin.BottomRight"
									 TransformOrigin="Origin.TopRight">

								<MudMenuItem Icon="@Icons.Material.Filled.Edit"
											 OnClick="@(() => EditStorageLocationAsync(context.Item))">
									Edit
								</MudMenuItem>

								@if (context.Item.IsActive)
								{
									<MudMenuItem Icon="@Icons.Material.Filled.Block"
												 IconColor="Color.Error"
												 OnClick="@(() => DeactivateStorageLocationAsync(context.Item))">
										Deactivate
									</MudMenuItem>
								}
								else
								{
									<MudMenuItem Icon="@Icons.Material.Filled.Restore"
												 IconColor="Color.Success"
												 OnClick="@(() => ReactivateStorageLocationAsync(context.Item))">
										Reactivate
									</MudMenuItem>
								}
							</MudMenu>
						</CellTemplate>
					</TemplateColumn>
				</Columns>

				<PagerContent>
					<MudDataGridPager T="StorageLocationDetails" />
				</PagerContent>
			</MudDataGrid>
		}
	</MudStack>
</MudContainer>
