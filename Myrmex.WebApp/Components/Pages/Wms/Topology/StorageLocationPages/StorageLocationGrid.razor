@using MudBlazor
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="StorageLocationDetails"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Single"
             Filterable="false">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="@Localizer["Common.Code"]" Tag="@StorageLocationSortBy.Code" />
        <PropertyColumn Property="x => x.Name" Title="@Localizer["Common.Name"]" Tag="@StorageLocationSortBy.Name" />
        <PropertyColumn Property="x => x.Description" Title="@Localizer["Common.Description"]" Sortable="false" />

        <TemplateColumn Title="@Localizer["Common.Type"]" Sortable="false" Filterable="false">
            <CellTemplate>
                @GetStorageLocationTypeDisplayName(context.Item.StorageLocationTypeId)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Status"]" Sortable="false" Filterable="false">
            <CellTemplate>
                @GetStorageLocationStatusDisplayName(context.Item.StorageLocationStatusId)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["StorageLocation.Pickable"]"
                        Tag="@StorageLocationSortBy.IsPickable"
                        SortBy="@(location => location.IsPickable)"
                        Sortable="true"
                        Filterable="false">
            <CellTemplate>
                @if (context.Item.IsPickable)
                {
                    <MudTooltip Text="@Localizer["StorageLocation.Pickable"]">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@Localizer["StorageLocation.NotPickable"]">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Active"]"
                        Tag="@StorageLocationSortBy.IsActive"
                        SortBy="@(location => location.IsActive)"
                        Sortable="true"
                        Filterable="false">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudTooltip Text="@Localizer["Common.Active"]">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@Localizer["Common.Inactive"]">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.CreatedAtUtc" Title="@Localizer["Common.CreatedUtc"]" Tag="@StorageLocationSortBy.CreatedAtUtc" />
        <PropertyColumn Property="x => x.UpdatedAtUtc" Title="@Localizer["Common.UpdatedUtc"]" Tag="@StorageLocationSortBy.UpdatedAtUtc" />

        <TemplateColumn Title="@Localizer["Common.Actions"]" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => EditRequested.InvokeAsync(context.Item))">
                        @Localizer["Common.Edit"]
                    </MudMenuItem>

                    @if (context.Item.IsActive)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Error"
                                     OnClick="@(() => DeactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Deactivate"]
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Restore"
                                     IconColor="Color.Success"
                                     OnClick="@(() => ReactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Reactivate"]
                        </MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="StorageLocationDetails" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public Func<StorageLocationGridRequest, CancellationToken, Task<GridData<StorageLocationDetails>>> LoadData { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<StorageLocationTypeDetails> StorageLocationTypes { get; set; } = [];

    [Parameter]
    public IReadOnlyList<StorageLocationStatusDetails> StorageLocationStatuses { get; set; } = [];

    [Parameter]
    public EventCallback<StorageLocationDetails> EditRequested { get; set; }

    [Parameter]
    public EventCallback<StorageLocationDetails> DeactivateRequested { get; set; }

    [Parameter]
    public EventCallback<StorageLocationDetails> ReactivateRequested { get; set; }

    private MudDataGrid<StorageLocationDetails>? _dataGrid;
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private Task<GridData<StorageLocationDetails>> LoadServerDataAsync(
        GridState<StorageLocationDetails> state,
        CancellationToken cancellationToken)
    {
        SortDefinition<StorageLocationDetails>? sortDefinition = state.SortDefinitions.FirstOrDefault();
        StorageLocationGridRequest request = new(
            state.Page * state.PageSize,
            state.PageSize,
            ResolveSortBy(sortDefinition),
            sortDefinition?.Descending ?? false);

        return LoadData(request, cancellationToken);
    }

    private string ResolveSortBy(SortDefinition<StorageLocationDetails>? sortDefinition)
    {
        if (sortDefinition is null)
        {
            return StorageLocationSortBy.Code;
        }

        Column<StorageLocationDetails>? column = _dataGrid?.GetColumnByPropertyName(sortDefinition.SortBy);
        return column?.Tag as string ?? StorageLocationSortBy.Code;
    }

    public Task ReloadServerDataAsync()
    {
        return _dataGrid?.ReloadServerData() ?? Task.CompletedTask;
    }

    public async Task ResetAndReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        if (_dataGrid.CurrentPage == 0)
        {
            await _dataGrid.ReloadServerData();
            return;
        }

        _dataGrid.NavigateTo(Page.First);
    }

    private string GetStorageLocationTypeDisplayName(Guid storageLocationTypeId)
    {
        StorageLocationTypeDetails? type = StorageLocationTypes
            .FirstOrDefault(x => x.Id == storageLocationTypeId);

        return type is null
            ? storageLocationTypeId.ToString()
            : $"{type.Code} - {type.Name}";
    }

    private string GetStorageLocationStatusDisplayName(Guid storageLocationStatusId)
    {
        StorageLocationStatusDetails? status = StorageLocationStatuses
            .FirstOrDefault(x => x.Id == storageLocationStatusId);

        return status is null
            ? storageLocationStatusId.ToString()
            : $"{status.Code} - {status.Name}";
    }
}
