@using MudBlazor
@using Myrmex.WebApp.Wms.Topology

<MudDataGrid T="StorageLocationDetails"
             Items="StorageLocations"
             Loading="IsLoading"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Multiple"
             Filterable="false">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="Code" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Description" Title="Description" />

        <TemplateColumn Title="Type" Sortable="false" Filterable="false">
            <CellTemplate>
                @GetStorageLocationTypeDisplayName(context.Item.StorageLocationTypeId)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Status" Sortable="false" Filterable="false">
            <CellTemplate>
                @GetStorageLocationStatusDisplayName(context.Item.StorageLocationStatusId)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Pickable" Sortable="false" Filterable="false">
            <CellTemplate>
                @if (context.Item.IsPickable)
                {
                    <MudTooltip Text="Pickable">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Not pickable">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Active" Sortable="false" Filterable="false">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudTooltip Text="Active">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Inactive">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.CreatedAtUtc" Title="Created UTC" />
        <PropertyColumn Property="x => x.UpdatedAtUtc" Title="Updated UTC" />

        <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => EditRequested.InvokeAsync(context.Item))">
                        Edit
                    </MudMenuItem>

                    @if (context.Item.IsActive)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Error"
                                     OnClick="@(() => DeactivateRequested.InvokeAsync(context.Item))">
                            Deactivate
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Restore"
                                     IconColor="Color.Success"
                                     OnClick="@(() => ReactivateRequested.InvokeAsync(context.Item))">
                            Reactivate
                        </MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="StorageLocationDetails" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter]
    public IEnumerable<StorageLocationDetails> StorageLocations { get; set; } = [];

    [Parameter]
    public IReadOnlyList<StorageLocationTypeDetails> StorageLocationTypes { get; set; } = [];

    [Parameter]
    public IReadOnlyList<StorageLocationStatusDetails> StorageLocationStatuses { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<StorageLocationDetails> EditRequested { get; set; }

    [Parameter]
    public EventCallback<StorageLocationDetails> DeactivateRequested { get; set; }

    [Parameter]
    public EventCallback<StorageLocationDetails> ReactivateRequested { get; set; }

    private string GetStorageLocationTypeDisplayName(Guid storageLocationTypeId)
    {
        StorageLocationTypeDetails? type = StorageLocationTypes
            .FirstOrDefault(x => x.Id == storageLocationTypeId);

        return type is null
            ? storageLocationTypeId.ToString()
            : $"{type.Code} - {type.Name}";
    }

    private string GetStorageLocationStatusDisplayName(Guid storageLocationStatusId)
    {
        StorageLocationStatusDetails? status = StorageLocationStatuses
            .FirstOrDefault(x => x.Id == storageLocationStatusId);

        return status is null
            ? storageLocationStatusId.ToString()
            : $"{status.Code} - {status.Name}";
    }
}
