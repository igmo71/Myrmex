@page "/wms/topology/zones"

@using MudBlazor
@using Myrmex.WebApp.Wms.Topology

<PageTitle>WMS Zones</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">Zones</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					WMS warehouse zones.
				</MudText>
			</div>

			<MudStack Row="true" Spacing="2">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="CreateZoneAsync"
						   Disabled="_isLoading || _selectedWarehouseId is null">
					Create
				</MudButton>

				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Refresh"
						   OnClick="ReloadAsync"
						   Disabled="_isLoading">
					Refresh
				</MudButton>
			</MudStack>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<ZoneFilters Warehouses="@_warehouses"
					 SelectedWarehouseId="@_selectedWarehouseId"
					 SelectedWarehouseIdChanged="OnWarehouseChanged"
					 IsLoadingWarehouses="@_isLoadingWarehouses"
					 SearchText="@_searchText"
					 SearchTextChanged="OnSearchTextChanged"
					 IncludeInactive="@_includeInactive"
					 IncludeInactiveChanged="OnIncludeInactiveChanged" />

		@if (_selectedWarehouseId is null)
		{
			<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
				Select a warehouse to view zones.
			</MudAlert>
		}
		else
		{
			<MudDataGrid T="ZoneDetails"
						 Items="_zones"
						 Loading="_isLoading"
						 Dense="true"
						 Hover="true"
						 Bordered="true"
						 Striped="true"
						 SortMode="SortMode.Multiple"
						 Filterable="false">
				<Columns>
					<PropertyColumn Property="x => x.Code" Title="Code" />
					<PropertyColumn Property="x => x.Name" Title="Name" />
					<PropertyColumn Property="x => x.Description" Title="Description" />

					<TemplateColumn Title="Active" Sortable="false" Filterable="false">
						<CellTemplate>
							@if (context.Item.IsActive)
							{
								<MudTooltip Text="Active">
									<MudIcon Icon="@Icons.Material.Filled.CheckCircle"
											 Color="Color.Success" />
								</MudTooltip>
							}
							else
							{
								<MudTooltip Text="Inactive">
									<MudIcon Icon="@Icons.Material.Filled.Cancel"
											 Color="Color.Error" />
								</MudTooltip>
							}
						</CellTemplate>
					</TemplateColumn>

					<PropertyColumn Property="x => x.CreatedAtUtc" Title="Created UTC" />
					<PropertyColumn Property="x => x.UpdatedAtUtc" Title="Updated UTC" />

					<TemplateColumn Title="Actions" Sortable="false" Filterable="false">
						<CellTemplate>
							<MudMenu Icon="@Icons.Material.Filled.MoreVert"
									 Size="Size.Small"
									 Dense="true"
									 AnchorOrigin="Origin.BottomRight"
									 TransformOrigin="Origin.TopRight">

								<MudMenuItem Icon="@Icons.Material.Filled.Edit"
											 OnClick="@(() => EditZoneAsync(context.Item))">
									Edit
								</MudMenuItem>

								@if (context.Item.IsActive)
								{
									<MudMenuItem Icon="@Icons.Material.Filled.Block"
												 IconColor="Color.Error"
												 OnClick="@(() => DeactivateZoneAsync(context.Item))">
										Deactivate
									</MudMenuItem>
								}
								else
								{
									<MudMenuItem Icon="@Icons.Material.Filled.Restore"
												 IconColor="Color.Success"
												 OnClick="@(() => ReactivateZoneAsync(context.Item))">
										Reactivate
									</MudMenuItem>
								}

								<MudDivider />

								<MudMenuItem Icon="@Icons.Material.Filled.LocationOn"
											 OnClick="@(() => NavigateToLocations(context.Item))">
									Locations
								</MudMenuItem>
							</MudMenu>
						</CellTemplate>
					</TemplateColumn>
				</Columns>

				<PagerContent>
					<MudDataGridPager T="ZoneDetails" />
				</PagerContent>
			</MudDataGrid>
		}
	</MudStack>
</MudContainer>
