@page "/wms/topology/zones"

@using MudBlazor
@using Myrmex.WebApp.Wms.Topology

<PageTitle>WMS Zones</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">Zones</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					WMS warehouse zones.
				</MudText>
			</div>

			<MudStack Row="true" Spacing="2">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="CreateZoneAsync"
						   Disabled="_isLoading || _selectedWarehouseId is null">
					Create
				</MudButton>

				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Refresh"
						   OnClick="ReloadAsync"
						   Disabled="_isLoading">
					Refresh
				</MudButton>
			</MudStack>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<ZoneFilters Warehouses="@_warehouses"
					 SelectedWarehouseId="@_selectedWarehouseId"
					 SelectedWarehouseIdChanged="OnWarehouseChanged"
					 IsLoadingWarehouses="@_isLoadingWarehouses"
					 SearchText="@_searchText"
					 SearchTextChanged="OnSearchTextChanged"
					 IncludeInactive="@_includeInactive"
					 IncludeInactiveChanged="OnIncludeInactiveChanged" />

		@if (_selectedWarehouseId is null)
		{
			<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
				Select a warehouse to view zones.
			</MudAlert>
		}
		else
		{
			<ZoneGrid Zones="@_zones"
					  IsLoading="@_isLoading"
					  EditRequested="EditZoneAsync"
					  DeactivateRequested="DeactivateZoneAsync"
					  ReactivateRequested="ReactivateZoneAsync"
					  LocationsRequested="NavigateToLocations" />
		}
	</MudStack>
</MudContainer>
