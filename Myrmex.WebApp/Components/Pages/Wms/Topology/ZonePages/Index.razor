@page "/wms/topology/zones"

@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Zone.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
	<MudStack Spacing="3">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<div>
				<MudText Typo="Typo.h5">@Localizer["Zone.Heading"]</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					@Localizer["Zone.Description"]
				</MudText>
			</div>

			<MudStack Row="true" Spacing="2">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Add"
						   OnClick="CreateZoneAsync"
						   Disabled="_selectedWarehouseId is null">
					@Localizer["Common.Create"]
				</MudButton>

				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.Refresh"
						   OnClick="ReloadAsync">
					@Localizer["Common.Refresh"]
				</MudButton>
			</MudStack>
		</MudStack>

		@if (!string.IsNullOrWhiteSpace(_errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">
				@_errorMessage
			</MudAlert>
		}

		<ZoneFilters SelectedWarehouse="@_selectedWarehouse"
					 SelectedWarehouseChanged="OnWarehouseChanged"
					 SearchWarehouses="SearchWarehousesAsync"
					 SearchText="@_searchText"
					 SearchTextChanged="OnSearchTextChanged"
					 IncludeInactive="@_includeInactive"
					 IncludeInactiveChanged="OnIncludeInactiveChanged" />

		@if (_selectedWarehouseId is null)
		{
			<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
				@Localizer["Zone.SelectWarehousePrompt"]
			</MudAlert>
		}
		else
		{
			<ZoneGrid @ref="_zoneGrid"
					  LoadData="LoadZonesAsync"
					  EditRequested="EditZoneAsync"
					  DeactivateRequested="DeactivateZoneAsync"
					  ReactivateRequested="ReactivateZoneAsync"
					  LocationsRequested="NavigateToLocations" />
		}
	</MudStack>
</MudContainer>
