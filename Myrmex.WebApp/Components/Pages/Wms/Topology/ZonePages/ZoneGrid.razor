@using MudBlazor
@using Myrmex.Shared.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="ZoneDetails"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Single"
             Filterable="false">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="@Localizer["Common.Code"]" Tag="@ZoneSortBy.Code" />
        <PropertyColumn Property="x => x.Name" Title="@Localizer["Common.Name"]" Tag="@ZoneSortBy.Name" />
        <PropertyColumn Property="x => x.Description" Title="@Localizer["Common.Description"]" Sortable="false" />

        <TemplateColumn Title="@Localizer["Common.Active"]"
                        Tag="@ZoneSortBy.IsActive"
                        SortBy="@(zone => zone.IsActive)"
                        Sortable="true"
                        Filterable="false">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudTooltip Text="@Localizer["Common.Active"]">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@Localizer["Common.Inactive"]">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.CreatedAtUtc" Title="@Localizer["Common.CreatedUtc"]" Tag="@ZoneSortBy.CreatedAtUtc" />
        <PropertyColumn Property="x => x.UpdatedAtUtc" Title="@Localizer["Common.UpdatedUtc"]" Tag="@ZoneSortBy.UpdatedAtUtc" />

        <TemplateColumn Title="@Localizer["Common.Actions"]" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => EditRequested.InvokeAsync(context.Item))">
                        @Localizer["Common.Edit"]
                    </MudMenuItem>

                    @if (context.Item.IsActive)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Error"
                                     OnClick="@(() => DeactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Deactivate"]
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Restore"
                                     IconColor="Color.Success"
                                     OnClick="@(() => ReactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Reactivate"]
                        </MudMenuItem>
                    }

                    <MudDivider />

                    <MudMenuItem Icon="@Icons.Material.Filled.LocationOn"
                                 OnClick="@(() => LocationsRequested.InvokeAsync(context.Item))">
                        @Localizer["StorageLocation.Heading"]
                    </MudMenuItem>
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="ZoneDetails" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public Func<ZoneGridRequest, CancellationToken, Task<GridData<ZoneDetails>>> LoadData { get; set; } = default!;

    [Parameter]
    public EventCallback<ZoneDetails> EditRequested { get; set; }

    [Parameter]
    public EventCallback<ZoneDetails> DeactivateRequested { get; set; }

    [Parameter]
    public EventCallback<ZoneDetails> ReactivateRequested { get; set; }

    [Parameter]
    public EventCallback<ZoneDetails> LocationsRequested { get; set; }

    private MudDataGrid<ZoneDetails>? _dataGrid;
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private Task<GridData<ZoneDetails>> LoadServerDataAsync(
        GridState<ZoneDetails> state,
        CancellationToken cancellationToken)
    {
        SortDefinition<ZoneDetails>? sortDefinition = state.SortDefinitions.FirstOrDefault();
        ZoneGridRequest request = new(
            state.Page * state.PageSize,
            state.PageSize,
            ResolveSortBy(sortDefinition),
            sortDefinition?.Descending ?? false);

        return LoadData(request, cancellationToken);
    }

    private string ResolveSortBy(SortDefinition<ZoneDetails>? sortDefinition)
    {
        if (sortDefinition is null)
        {
            return ZoneSortBy.Code;
        }

        Column<ZoneDetails>? column = _dataGrid?.GetColumnByPropertyName(sortDefinition.SortBy);
        return column?.Tag as string ?? ZoneSortBy.Code;
    }

    public Task ReloadServerDataAsync()
    {
        return _dataGrid?.ReloadServerData() ?? Task.CompletedTask;
    }

    public async Task ResetAndReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        if (_dataGrid.CurrentPage == 0)
        {
            await _dataGrid.ReloadServerData();
            return;
        }

        _dataGrid.NavigateTo(Page.First);
    }
}
