@using MudBlazor
@using Myrmex.WebApp.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              Label="@Localizer["Common.Code"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Disabled="IsEditMode"
                              Required="true"
                              RequiredError="@Localizer["Common.CodeRequired"]"
                              MaxLength="32"
                              @bind-Value="_model.Code" />

                <MudTextField T="string"
                              Label="@Localizer["Common.Name"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="@Localizer["Common.NameRequired"]"
                              MaxLength="200"
                              @bind-Value="_model.Name" />

                <MudTextField T="string"
                              Label="@Localizer["Common.Description"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="3"
                              MaxLength="1000"
                              @bind-Value="_model.Description" />

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                        @_errorMessage
                    </MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="_isSaving">
            @Localizer["Common.Cancel"]
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="me-2" />
            }
            @Localizer["Common.Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid WarehouseId { get; set; }

    [Parameter]
    public ZoneDetails? Zone { get; set; }

    [Inject]
    private WmsTopologyApiClient WmsTopologyApiClient { get; set; } = null!;

    private MudForm? _form;
    private readonly ZoneEditModel _model = new();
    private bool _isSaving;
    private string? _errorMessage;

    private bool IsEditMode => Zone is not null;

    private string Title => IsEditMode ? Localizer["Zone.EditTitle"] : Localizer["Zone.CreateTitle"];

    protected override void OnInitialized()
    {
        if (Zone is null)
        {
            return;
        }

        _model.Code = Zone.Code;
        _model.Name = Zone.Name;
        _model.Description = Zone.Description;
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            ApiResult<ZoneDetails> result;

            if (Zone is null)
            {
                CreateZoneRequest request = new(
                    Code: _model.Code,
                    Name: _model.Name,
                    Description: _model.Description);

                result = await WmsTopologyApiClient.TryCreateZoneAsync(
                    WarehouseId,
                    request);
            }
            else
            {
                UpdateZoneDetailsRequest request = new(
                    Name: _model.Name,
                    Description: _model.Description);

                result = await WmsTopologyApiClient.TryUpdateZoneDetailsAsync(
                    Zone.Id,
                    request);
            }

            if (result.IsFailure)
            {
                _errorMessage = result.Error?.Message;
                return;
            }

            if (result.Value is null)
            {
                _errorMessage = Localizer["Zone.MissingResult"];
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private sealed class ZoneEditModel
    {
        public string? Code { get; set; }

        public string? Name { get; set; }

        public string? Description { get; set; }
    }
}
