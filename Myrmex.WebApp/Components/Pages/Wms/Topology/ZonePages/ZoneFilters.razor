@using MudBlazor
@using Myrmex.WebApp.Wms.Topology
@inject IStringLocalizer<SharedResource> Localizer

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudAutocomplete T="WarehouseLookupItem"
                         Label="@Localizer["Common.Warehouse"]"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Clearable="true"
                         ShowProgressIndicator="true"
                         MinCharacters="0"
                         DebounceInterval="300"
                         MaxItems="20"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         CoerceValue="false"
                         Value="SelectedWarehouse"
                         ValueChanged="OnWarehouseChanged"
                         SearchFunc="SearchWarehouses"
                         ToStringFunc="FormatWarehouse"
                         Class="min-width-300">
            <ItemTemplate>
                <MudText Typo="Typo.body2">@context.Code - @context.Name</MudText>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText>@Localizer["Warehouse.NoneFound"]</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>

        <MudTextField T="string"
                      Label="@Localizer["Common.Search"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Value="SearchText"
                      ValueChanged="OnSearchTextChanged"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="flex-grow-1" />

        <MudSwitch T="bool"
                   Label="@Localizer["Common.IncludeInactive"]"
                   Color="Color.Primary"
                   Value="IncludeInactive"
                   ValueChanged="OnIncludeInactiveChanged" />
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public WarehouseLookupItem? SelectedWarehouse { get; set; }

    [Parameter]
    public EventCallback<WarehouseLookupItem?> SelectedWarehouseChanged { get; set; }

    [Parameter]
    public Func<string, CancellationToken, Task<IEnumerable<WarehouseLookupItem>>> SearchWarehouses { get; set; } =
        (_, _) => Task.FromResult(Enumerable.Empty<WarehouseLookupItem>());

    [Parameter]
    public string? SearchText { get; set; }

    [Parameter]
    public EventCallback<string?> SearchTextChanged { get; set; }

    [Parameter]
    public bool IncludeInactive { get; set; }

    [Parameter]
    public EventCallback<bool> IncludeInactiveChanged { get; set; }

    private async Task OnWarehouseChanged(WarehouseLookupItem? value)
    {
        await SelectedWarehouseChanged.InvokeAsync(value);
    }

    private async Task OnSearchTextChanged(string? value)
    {
        await SearchTextChanged.InvokeAsync(value);
    }

    private async Task OnIncludeInactiveChanged(bool value)
    {
        await IncludeInactiveChanged.InvokeAsync(value);
    }

    private static string FormatWarehouse(WarehouseLookupItem? warehouse) =>
        warehouse is null ? string.Empty : $"{warehouse.Code} - {warehouse.Name}";
}
