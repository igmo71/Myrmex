@using MudBlazor
@using Myrmex.WebApp.Wms.Catalog

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create UoM</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              Label="Code"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="Code is required."
                              MaxLength="32"
                              @bind-Value="_model.Code" />

                <MudTextField T="string"
                              Label="Name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="Name is required."
                              MaxLength="200"
                              @bind-Value="_model.Name" />

                <MudTextField T="string"
                              Label="Symbol"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="32"
                              @bind-Value="_model.Symbol" />

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                        @_errorMessage
                    </MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="_isSaving">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private WmsCatalogApiClient WmsCatalogApiClient { get; set; } = null!;

    private MudForm? _form;
    private readonly UomEditModel _model = new();
    private bool _isSaving;
    private string? _errorMessage;

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            CreateUnitOfMeasureRequest request = new(
                Code: _model.Code,
                Name: _model.Name,
                Symbol: _model.Symbol);

            ApiResult<UnitOfMeasureDetails> result = await WmsCatalogApiClient
                .TryCreateUnitOfMeasureAsync(request);

            if (result.IsFailure)
            {
                _errorMessage = result.Error?.Message;
                return;
            }

            if (result.Value is null)
            {
                _errorMessage = "The operation completed without returning UoM details.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private sealed class UomEditModel
    {
        public string? Code { get; set; }

        public string? Name { get; set; }

        public string? Symbol { get; set; }
    }
}
