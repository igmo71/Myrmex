@using MudBlazor
@using Microsoft.AspNetCore.Components
@using Myrmex.Shared.Wms.Catalog
@using Myrmex.WebApp.Wms.Catalog
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="UnitOfMeasureDetails"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Single"
             Filterable="false">
    <Columns>
        <PropertyColumn Property="x => x.Code"
                        Title="@Localizer["Common.Code"]"
                        Tag="@UnitOfMeasureSortBy.Code" />
        <PropertyColumn Property="x => x.Name"
                        Title="@Localizer["Common.Name"]"
                        Tag="@UnitOfMeasureSortBy.Name" />

        <TemplateColumn Title="@Localizer["UnitOfMeasure.Symbol"]" Sortable="false" Filterable="false">
            <CellTemplate>
                @context.Item.Symbol
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Active"]"
                        Tag="@UnitOfMeasureSortBy.IsActive"
                        SortBy="@(unit => unit.IsActive)"
                        Sortable="true"
                        Filterable="false"
                        CellClass="d-flex justify-center">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudTooltip Text="@Localizer["Common.Active"]">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@Localizer["Common.Inactive"]">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.CreatedUtc"]"
                        Tag="@UnitOfMeasureSortBy.CreatedAtUtc"
                        SortBy="@(unit => unit.CreatedAtUtc)"
                        Sortable="true"
                        Filterable="false">
            <CellTemplate>
                @context.Item.CreatedAtUtc
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.UpdatedUtc"]"
                        Tag="@UnitOfMeasureSortBy.UpdatedAtUtc"
                        SortBy="@(unit => unit.UpdatedAtUtc)"
                        Sortable="true"
                        Filterable="false">
            <CellTemplate>
                @context.Item.UpdatedAtUtc
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Actions"]" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => EditRequested.InvokeAsync(context.Item))">
                        @Localizer["Common.Edit"]
                    </MudMenuItem>

                    @if (context.Item.IsActive)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Error"
                                     OnClick="@(() => DeactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Deactivate"]
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Restore"
                                     IconColor="Color.Success"
                                     OnClick="@(() => ReactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Reactivate"]
                        </MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="UnitOfMeasureDetails" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public Func<UomGridRequest, CancellationToken, Task<GridData<UnitOfMeasureDetails>>> LoadData { get; set; } = default!;

    [Parameter]
    public EventCallback<UnitOfMeasureDetails> EditRequested { get; set; }

    [Parameter]
    public EventCallback<UnitOfMeasureDetails> DeactivateRequested { get; set; }

    [Parameter]
    public EventCallback<UnitOfMeasureDetails> ReactivateRequested { get; set; }

    private MudDataGrid<UnitOfMeasureDetails>? _dataGrid;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private Task<GridData<UnitOfMeasureDetails>> LoadServerDataAsync(
        GridState<UnitOfMeasureDetails> state,
        CancellationToken cancellationToken)
    {
        SortDefinition<UnitOfMeasureDetails>? sortDefinition =
            state.SortDefinitions.FirstOrDefault();

        UomGridRequest request = new(
            Skip: state.Page * state.PageSize,
            Take: state.PageSize,
            SortBy: ResolveSortBy(sortDefinition),
            SortDescending: sortDefinition?.Descending ?? false);

        return LoadData(request, cancellationToken);
    }

    private string ResolveSortBy(SortDefinition<UnitOfMeasureDetails>? sortDefinition)
    {
        if (sortDefinition is null)
        {
            return UnitOfMeasureSortBy.Code;
        }

        Column<UnitOfMeasureDetails>? column =
            _dataGrid?.GetColumnByPropertyName(sortDefinition.SortBy);

        return column?.Tag as string ?? UnitOfMeasureSortBy.Code;
    }

    public Task ReloadServerDataAsync()
    {
        return _dataGrid?.ReloadServerData() ?? Task.CompletedTask;
    }

    public async Task ResetAndReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        if (_dataGrid.CurrentPage == 0)
        {
            await _dataGrid.ReloadServerData();
            return;
        }

        _dataGrid.NavigateTo(Page.First);
    }
}
