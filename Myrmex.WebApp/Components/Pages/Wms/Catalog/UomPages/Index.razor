@page "/wms/catalog/uoms"

@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["UnitOfMeasure.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">@Localizer["UnitOfMeasure.Heading"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["UnitOfMeasure.Description"]
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="CreateUnitOfMeasureAsync"
                           Disabled="_isLoading">
                    @Localizer["Common.Create"]
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync"
                           Disabled="_isLoading">
                    @Localizer["Common.Refresh"]
                </MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                @_errorMessage
            </MudAlert>
        }

        <UomFilters SearchText="@_searchText"
                    SearchTextChanged="OnSearchTextChanged"
                    IncludeInactive="@_includeInactive"
                    IncludeInactiveChanged="OnIncludeInactiveChanged" />

        <UomGrid UnitsOfMeasure="@_unitsOfMeasure"
                 IsLoading="@_isLoading"
                 EditRequested="EditUnitOfMeasureAsync"
                 DeactivateRequested="DeactivateUnitOfMeasureAsync"
                 ReactivateRequested="ReactivateUnitOfMeasureAsync" />
    </MudStack>
</MudContainer>
