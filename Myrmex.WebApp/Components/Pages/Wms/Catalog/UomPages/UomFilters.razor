@using MudBlazor

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudTextField T="string"
                      Label="Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Value="SearchText"
                      ValueChanged="OnSearchTextChanged"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="flex-grow-1" />

        <MudSwitch T="bool"
                   Label="Include inactive"
                   Color="Color.Primary"
                   Value="IncludeInactive"
                   ValueChanged="OnIncludeInactiveChanged" />
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public string? SearchText { get; set; }

    [Parameter]
    public EventCallback<string?> SearchTextChanged { get; set; }

    [Parameter]
    public bool IncludeInactive { get; set; }

    [Parameter]
    public EventCallback<bool> IncludeInactiveChanged { get; set; }

    private async Task OnSearchTextChanged(string? value)
    {
        await SearchTextChanged.InvokeAsync(value);
    }

    private async Task OnIncludeInactiveChanged(bool value)
    {
        await IncludeInactiveChanged.InvokeAsync(value);
    }
}
