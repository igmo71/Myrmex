@using MudBlazor
@using System.Globalization
@using Myrmex.Shared.Common
@using Myrmex.WebApp.Wms.Api
@using Myrmex.WebApp.Wms.Catalog
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              Label="@Localizer["Common.Code"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Disabled="IsEditMode"
                              Required="true"
                              RequiredError="@Localizer["Common.CodeRequired"]"
                              MaxLength="32"
                              @bind-Value="_model.Code" />

                <MudTextField T="string"
                              Label="@Localizer["Common.Name"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="@Localizer["Common.NameRequired"]"
                              MaxLength="200"
                              @bind-Value="_model.Name" />

                <MudTextField T="string"
                              Label="@Localizer["Common.Description"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="3"
                              MaxLength="1000"
                              @bind-Value="_model.Description" />

                <MudSelect T="Guid?"
                           Label="@Localizer["Sku.BaseUnitOfMeasure"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="_isLoadingUnitsOfMeasure"
                           Required="true"
                           RequiredError="@Localizer["Sku.BaseUnitOfMeasureRequired"]"
                           @bind-Value="_model.BaseUnitOfMeasureId">
                    @foreach (UnitOfMeasureDetails unitOfMeasure in _unitsOfMeasure)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)unitOfMeasure.Id)">
                            @unitOfMeasure.Code - @unitOfMeasure.Name
                        </MudSelectItem>
                    }
                </MudSelect>

                @if (IsEditMode && Sku is not null)
                {
                    <MudDivider />
                    <MudText Typo="Typo.subtitle2">@Localizer["Sku.PhysicalCharacteristics"]</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption">@Localizer["Sku.Weight"]</MudText>
                            <MudText>@FormatCharacteristic(Sku.WeightKilograms, "kg")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption">@Localizer["Sku.Length"]</MudText>
                            <MudText>@FormatCharacteristic(Sku.LengthMetres, "m")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption">@Localizer["Sku.Area"]</MudText>
                            <MudText>@FormatCharacteristic(Sku.AreaSquareMetres, "m²")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption">@Localizer["Sku.Volume"]</MudText>
                            <MudText>@FormatCharacteristic(Sku.VolumeCubicMetres, "m³")</MudText>
                        </MudItem>
                    </MudGrid>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                        @_errorMessage
                    </MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="_isSaving">
            @Localizer["Common.Cancel"]
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="_isSaving || _isLoadingUnitsOfMeasure">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            @Localizer["Common.Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public StockKeepingUnitDetails? Sku { get; set; }

    [Inject]
    private WmsCatalogApiClient WmsCatalogApiClient { get; set; } = null!;

    private MudForm? _form;
    private readonly SkuEditModel _model = new();
    private List<UnitOfMeasureDetails> _unitsOfMeasure = [];
    private bool _isSaving;
    private bool _isLoadingUnitsOfMeasure;
    private string? _errorMessage;

    private bool IsEditMode => Sku is not null;

    private string Title => IsEditMode ? Localizer["Sku.EditTitle"] : Localizer["Sku.CreateTitle"];

    private string FormatCharacteristic(decimal? value, string unit) =>
        value.HasValue
            ? $"{value.Value.ToString("0.############", CultureInfo.CurrentCulture)} {unit}"
            : Localizer["Common.NotAvailable"];

    protected override async Task OnInitializedAsync()
    {
        if (Sku is not null)
        {
            _model.Code = Sku.Code;
            _model.Name = Sku.Name;
            _model.Description = Sku.Description;
            _model.BaseUnitOfMeasureId = Sku.BaseUnitOfMeasureId;
        }

        await LoadUnitsOfMeasureAsync();
    }

    private async Task LoadUnitsOfMeasureAsync()
    {
        _isLoadingUnitsOfMeasure = true;
        _errorMessage = null;

        try
        {
            ListUnitsOfMeasureRequest request = new()
            {
                Skip = 0,
                Take = 100,
                SortBy = UnitOfMeasureSortBy.Code,
                SortDescending = false,
                IncludeInactive = false
            };

            ListResult<UnitOfMeasureDetails> result = await WmsCatalogApiClient
                .ListUnitsOfMeasureAsync(request);

            _unitsOfMeasure = result.Items.ToList();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            _unitsOfMeasure = [];
        }
        finally
        {
            _isLoadingUnitsOfMeasure = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            ApiResult<StockKeepingUnitDetails> result;

            if (Sku is null)
            {
                if (_model.BaseUnitOfMeasureId is null)
                {
                    _errorMessage = Localizer["Sku.BaseUnitOfMeasureRequired"];
                    return;
                }

                CreateStockKeepingUnitRequest request = new(
                    Code: _model.Code,
                    Name: _model.Name,
                    Description: _model.Description,
                    BaseUnitOfMeasureId: _model.BaseUnitOfMeasureId);

                result = await WmsCatalogApiClient.TryCreateStockKeepingUnitAsync(request);
            }
            else
            {
                if (_model.BaseUnitOfMeasureId is null)
                {
                    _errorMessage = Localizer["Sku.BaseUnitOfMeasureRequired"];
                    return;
                }

                UpdateStockKeepingUnitDetailsRequest request = new(
                    Name: _model.Name,
                    Description: _model.Description,
                    BaseUnitOfMeasureId: _model.BaseUnitOfMeasureId);

                result = await WmsCatalogApiClient.TryUpdateStockKeepingUnitDetailsAsync(
                    Sku.Id,
                    request);
            }

            if (result.IsFailure)
            {
                _errorMessage = result.Error?.Message;
                return;
            }

            if (result.Value is null)
            {
                _errorMessage = Localizer["Sku.MissingResult"];
                return;
            }

            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private sealed class SkuEditModel
    {
        public string? Code { get; set; }

        public string? Name { get; set; }

        public string? Description { get; set; }

        public Guid? BaseUnitOfMeasureId { get; set; }
    }
}
