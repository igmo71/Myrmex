@page "/wms/catalog/skus"

@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Sku.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">@Localizer["Sku.Heading"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["Sku.Description"]
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="CreateSkuAsync">
                    @Localizer["Common.Create"]
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync">
                    @Localizer["Common.Refresh"]
                </MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                @_errorMessage
            </MudAlert>
        }

        <SkuFilters SearchText="@_searchText"
                    SearchTextChanged="OnSearchTextChanged"
                    IncludeInactive="@_includeInactive"
                    IncludeInactiveChanged="OnIncludeInactiveChanged" />

        <SkuGrid @ref="_skuGrid"
                 LoadData="LoadSkusAsync"
                 UnitOfMeasureLookup="@_unitOfMeasureLookup"
                 EditRequested="EditSkuAsync"
                 DeactivateRequested="DeactivateSkuAsync"
                 ReactivateRequested="ReactivateSkuAsync" />
    </MudStack>
</MudContainer>
