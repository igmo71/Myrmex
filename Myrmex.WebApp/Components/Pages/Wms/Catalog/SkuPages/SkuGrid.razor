@using MudBlazor
@using Myrmex.WebApp.Wms.Catalog
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="StockKeepingUnitDetails"
             Items="Skus"
             Loading="IsLoading"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Multiple"
             Filterable="false">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="@Localizer["Common.Code"]" />
        <PropertyColumn Property="x => x.Name" Title="@Localizer["Common.Name"]" />
        <PropertyColumn Property="x => x.Description" Title="@Localizer["Common.Description"]" />
        <TemplateColumn Title="@Localizer["Sku.BaseUnitOfMeasure"]"
                        Sortable="false"
                        Filterable="false">
            <CellTemplate>
                @GetBaseUnitOfMeasureDisplay(context.Item)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Active"]"
                        Sortable="false"
                        Filterable="false"
                        CellClass="d-flex justify-center">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudTooltip Text="@Localizer["Common.Active"]">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@Localizer["Common.Inactive"]">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.CreatedAtUtc" Title="@Localizer["Common.CreatedUtc"]" />
        <PropertyColumn Property="x => x.UpdatedAtUtc" Title="@Localizer["Common.UpdatedUtc"]" />

        <TemplateColumn Title="@Localizer["Common.Actions"]" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => EditRequested.InvokeAsync(context.Item))">
                        @Localizer["Common.Edit"]
                    </MudMenuItem>

                    @if (context.Item.IsActive)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Error"
                                     OnClick="@(() => DeactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Deactivate"]
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Restore"
                                     IconColor="Color.Success"
                                     OnClick="@(() => ReactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Reactivate"]
                        </MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="StockKeepingUnitDetails" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter]
    public IReadOnlyList<StockKeepingUnitDetails> Skus { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<Guid, UnitOfMeasureDetails> UnitOfMeasureLookup { get; set; } =
        new Dictionary<Guid, UnitOfMeasureDetails>();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<StockKeepingUnitDetails> EditRequested { get; set; }

    [Parameter]
    public EventCallback<StockKeepingUnitDetails> DeactivateRequested { get; set; }

    [Parameter]
    public EventCallback<StockKeepingUnitDetails> ReactivateRequested { get; set; }

    private string GetBaseUnitOfMeasureDisplay(StockKeepingUnitDetails sku)
    {
        if (UnitOfMeasureLookup.TryGetValue(sku.BaseUnitOfMeasureId, out UnitOfMeasureDetails? unitOfMeasure))
        {
            return $"{unitOfMeasure.Code} - {unitOfMeasure.Name}";
        }

        return sku.BaseUnitOfMeasureId.ToString();
    }
}
