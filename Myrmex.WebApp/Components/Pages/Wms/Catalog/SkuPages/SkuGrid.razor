@using MudBlazor
@using Myrmex.Shared.Wms.Catalog
@using Myrmex.WebApp.Wms.Catalog
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="StockKeepingUnitDetails"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             SortMode="SortMode.Single"
             Filterable="false">
    <Columns>
        <PropertyColumn Property="x => x.Code"
                        Title="@Localizer["Common.Code"]"
                        Tag="@StockKeepingUnitSortBy.Code" />
        <PropertyColumn Property="x => x.Name"
                        Title="@Localizer["Common.Name"]"
                        Tag="@StockKeepingUnitSortBy.Name" />
        <PropertyColumn Property="x => x.Description"
                        Title="@Localizer["Common.Description"]"
                        Sortable="false" />
        <TemplateColumn Title="@Localizer["Sku.BaseUnitOfMeasure"]"
                        Sortable="false"
                        Filterable="false">
            <CellTemplate>
                @GetBaseUnitOfMeasureDisplay(context.Item)
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Common.Active"]"
                        Tag="@StockKeepingUnitSortBy.IsActive"
                        SortBy="@(sku => sku.IsActive)"
                        Sortable="true"
                        Filterable="false"
                        CellClass="d-flex justify-center">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudTooltip Text="@Localizer["Common.Active"]">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="@Localizer["Common.Inactive"]">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.CreatedAtUtc"
                        Title="@Localizer["Common.CreatedUtc"]"
                        Tag="@StockKeepingUnitSortBy.CreatedAtUtc" />
        <PropertyColumn Property="x => x.UpdatedAtUtc"
                        Title="@Localizer["Common.UpdatedUtc"]"
                        Tag="@StockKeepingUnitSortBy.UpdatedAtUtc" />

        <TemplateColumn Title="@Localizer["Common.Actions"]" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">

                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                 OnClick="@(() => EditRequested.InvokeAsync(context.Item))">
                        @Localizer["Common.Edit"]
                    </MudMenuItem>

                    @if (context.Item.IsActive)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                     IconColor="Color.Error"
                                     OnClick="@(() => DeactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Deactivate"]
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Restore"
                                     IconColor="Color.Success"
                                     OnClick="@(() => ReactivateRequested.InvokeAsync(context.Item))">
                            @Localizer["Common.Reactivate"]
                        </MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="StockKeepingUnitDetails" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public Func<SkuGridRequest, CancellationToken, Task<GridData<StockKeepingUnitDetails>>> LoadData { get; set; } = default!;

    [Parameter]
    public IReadOnlyDictionary<Guid, UnitOfMeasureDetails> UnitOfMeasureLookup { get; set; } =
        new Dictionary<Guid, UnitOfMeasureDetails>();

    [Parameter]
    public EventCallback<StockKeepingUnitDetails> EditRequested { get; set; }

    [Parameter]
    public EventCallback<StockKeepingUnitDetails> DeactivateRequested { get; set; }

    [Parameter]
    public EventCallback<StockKeepingUnitDetails> ReactivateRequested { get; set; }

    private MudDataGrid<StockKeepingUnitDetails>? _dataGrid;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private Task<GridData<StockKeepingUnitDetails>> LoadServerDataAsync(
        GridState<StockKeepingUnitDetails> state,
        CancellationToken cancellationToken)
    {
        SortDefinition<StockKeepingUnitDetails>? sortDefinition =
            state.SortDefinitions.FirstOrDefault();

        SkuGridRequest request = new(
            Skip: state.Page * state.PageSize,
            Take: state.PageSize,
            SortBy: ResolveSortBy(sortDefinition),
            SortDescending: sortDefinition?.Descending ?? false);

        return LoadData(request, cancellationToken);
    }

    private string ResolveSortBy(SortDefinition<StockKeepingUnitDetails>? sortDefinition)
    {
        if (sortDefinition is null)
        {
            return StockKeepingUnitSortBy.Code;
        }

        Column<StockKeepingUnitDetails>? column =
            _dataGrid?.GetColumnByPropertyName(sortDefinition.SortBy);

        return column?.Tag as string ?? StockKeepingUnitSortBy.Code;
    }

    public Task ReloadServerDataAsync()
    {
        return _dataGrid?.ReloadServerData() ?? Task.CompletedTask;
    }

    public async Task ResetAndReloadServerDataAsync()
    {
        if (_dataGrid is null)
        {
            return;
        }

        if (_dataGrid.CurrentPage == 0)
        {
            await _dataGrid.ReloadServerData();
            return;
        }

        _dataGrid.NavigateTo(Page.First);
    }

    private string GetBaseUnitOfMeasureDisplay(StockKeepingUnitDetails sku)
    {
        if (UnitOfMeasureLookup.TryGetValue(sku.BaseUnitOfMeasureId, out UnitOfMeasureDetails? unitOfMeasure))
        {
            return $"{unitOfMeasure.Code} - {unitOfMeasure.Name}";
        }

        return sku.BaseUnitOfMeasureId.ToString();
    }
}
