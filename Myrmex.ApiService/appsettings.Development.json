{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Myrmex": {
    "DevelopmentActor": {
      "Enabled": true,
      "ActorId": "dev-smoke-operator"
    },
    "Identity": {
      "ApiSession": {
        "LifetimeMinutes": 2
      },
      "DataProtection": {
        "ApplicationName": "Myrmex",
        "Certificate": {
          "Thumbprint": ""
        }
      },
      "InitialAdmin": {
        "Enabled": false,
        "Email": "",
        "DisplayName": ""
      }
    },
    "Wms": {
      "DemoData": {
        "Enabled": true,
        "AllowClear": true,
        "ClearConfirmation": "y"
      }
    }
  }
}
