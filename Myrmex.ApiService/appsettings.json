{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Myrmex": {
    "Integrations": {
      "OneC": {
        "Enabled": false,
        "WarehousesEntitySet": "Catalog_Склады",
        "UnitsOfMeasureEntitySet": "Catalog_УпаковкиЕдиницыИзмерения",
        "NomenclatureEntitySet": "Catalog_Номенклатура",
        "WarehouseCodeAvailable": true,
        "UseFolderFilter": true,
        "BatchSize": 1000,
        "TimeoutSeconds": 30
      }
    }
  },
  "AllowedHosts": "*"
}
